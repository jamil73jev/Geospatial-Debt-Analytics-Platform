                        data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                        data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                        data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                        data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>

                    <td class='seg-average seg-dynamic'
                        data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                        data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                        data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                        data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                        data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
                </tr>",
                ""
            ),

        "",
        [__Orden], ASC
    )

VAR _HtmlBrechas_COA =
    _HtmlResumenBrechas_COA
        & _HtmlDetalleBrechas_COA


/* ============================================================
   CONTRIBUYENTES CON AL MENOS UNA OBLIGACIÓN SIN UBICACIÓN
   Esta lectura sí se calcula como subconjunto de cada segmento.
   ============================================================ */
VAR _FiltroFase =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[CodFaseDeuda] ),
        "Todas",
        CONCATENATEX (
            VALUES ( 'GEOREFERENCIACION'[CodFaseDeuda] ),
            'GEOREFERENCIACION'[CodFaseDeuda],
            ", "
        )
    )

VAR _FiltroAnio =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[AnioIdDeuda] ),
        "Todos",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[AnioIdDeuda] ),
            FORMAT ( SELECTEDVALUE ( 'GEOREFERENCIACION'[AnioIdDeuda] ), "0" ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[AnioIdDeuda] ) ), "0" ) & " seleccionados"
        )
    )

VAR _FiltroRubro =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[TipoDeuda] ),
        "Todos",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[TipoDeuda] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[TipoDeuda] ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[TipoDeuda] ) ), "0" ) & " seleccionados"
        )
    )

VAR _FiltroAGA =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[AGA] ),
        "Todas",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[AGA] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[AGA] ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[AGA] ) ), "0" ) & " seleccionadas"
        )
    )

VAR _FiltroParroquia =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[Parroquia] ),
        "Todas",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[Parroquia] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[Parroquia] ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[Parroquia] ) ), "0" ) & " seleccionadas"
        )
    )

VAR _FiltroSector =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[SectorNomenclatura] ),
        "Todos",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[SectorNomenclatura] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[SectorNomenclatura] ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[SectorNomenclatura] ) ), "0" ) & " seleccionados"
        )
    )

VAR _FiltroEstado =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[EstadoEspecifico] ),
        "Todos los estados permitidos",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[EstadoEspecifico] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[EstadoEspecifico] ),
            FORMAT (
                COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[EstadoEspecifico] ) ),
                "0"
            ) & " seleccionados"
        )
    )

VAR _FiltroEdad =
    IF (
        NOT ISFILTERED ( 'GEOREFERENCIACION'[RangoAntiguedad] ),
        "Todas",
        IF (
            HASONEVALUE ( 'GEOREFERENCIACION'[RangoAntiguedad] ),
            SELECTEDVALUE ( 'GEOREFERENCIACION'[RangoAntiguedad] ),
            FORMAT ( COUNTROWS ( VALUES ( 'GEOREFERENCIACION'[RangoAntiguedad] ) ), "0" ) & " seleccionadas"
        )
    )

/* ============================================================
   FECHA DE CORTE MAESTRA
   Se mantiene independiente de los filtros del dashboard.
   ============================================================ */
VAR _FechaCorte =
    CALCULATE (
        MAX ( 'GEOREFERENCIACION'[FechaCorte] ),
        REMOVEFILTERS ( 'GEOREFERENCIACION' )
    )

VAR _FechaCorteTexto =
    IF (
        NOT ISBLANK ( _FechaCorte ),
        FORMAT ( _FechaCorte, "dd/MM/yyyy" ),
        "SIN FECHA DE CORTE"
    )

/* ============================================================
   INSIGHT EJECUTIVO
   ============================================================ */
RETURN
"
<style>
*{box-sizing:border-box}
body{margin:0;padding:0}
.dashboard{
 font-family:'Montserrat','Century Gothic','Aptos','Segoe UI',Arial,sans-serif;
 background:#f2f5f8;
 color:#172b3a;
 padding:17px 14px 14px;
 width:100%;
 position:relative
}
.dashboard:before{
 content:'';
 position:absolute;
 top:0;
 left:0;
 right:0;
 height:4px;
 background:linear-gradient(90deg,#0FACF1 0 38%,#241460 38% 76%,#FAD30A 76% 100%)
}
.hero{
 background:linear-gradient(135deg,#241460 0%,#2A3082 58%,#0FACF1 100%);
 color:white;
 border-radius:16px;
 padding:18px 22px;
 margin-bottom:10px;
 box-shadow:0 6px 18px rgba(36,20,96,.18);
 position:relative;
 overflow:hidden
}
.hero:after{
 content:'';
 position:absolute;
 left:0;
 right:0;
 bottom:0;
 height:4px;
 background:linear-gradient(90deg,#0FACF1 0 42%,#FAD30A 42% 72%,#24694F 72% 100%)
}
.hero-row{display:flex;justify-content:space-between;align-items:center;gap:20px}
.hero h1{font-size:28px;margin:0 0 4px;font-weight:760}
.hero p{font-size:12.5px;margin:0;opacity:.86}
.hero-badge{
 background:rgba(255,255,255,.12);
 border:1px solid rgba(255,255,255,.20);
 border-radius:10px;
 padding:9px 12px;
 font-size:10.5px;
 white-space:nowrap
}
.hero-meta{
 display:flex;
 flex-direction:column;
 align-items:flex-end;
 gap:6px;
 flex:0 0 auto
}
.hero-cutoff{
 background:rgba(250,211,10,.13);
 border:1px solid rgba(250,211,10,.75);
 border-radius:10px;
 padding:7px 12px;
 font-size:10.5px;
 font-weight:700;
 color:#ffffff;
 white-space:nowrap
}
.hero-cutoff strong{
 color:#FAD30A;
 font-size:12px;
 font-weight:850;
 margin-left:4px
}
.filters{
 display:grid;
 grid-template-columns:repeat(8,1fr);
 gap:6px;
 margin-bottom:10px
}
.filter{
 background:white;
 border:1px solid #e1e7eb;
 border-radius:9px;
 padding:7px 9px;
 min-width:0
}
.filter label{
 display:block;
 font-size:8.5px;
 font-weight:750;
 color:#241460;
 text-transform:uppercase;
 letter-spacing:.4px;
 margin-bottom:3px
}
.filter div{
 font-size:10.5px;
 font-weight:650;
 color:#153d59;
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis
}
.kpis{
 display:grid;
 grid-template-columns:repeat(7,1fr);
 gap:8px;
 margin-bottom:10px
}
.kpi{
 background:white;
 border-radius:11px;
 padding:11px;
 border-top:4px solid #0FACF1;
 box-shadow:0 2px 8px rgba(0,0,0,.05)
}
.kpi:nth-child(2){border-top-color:#FAD30A}
.kpi:nth-child(3){border-top-color:#24694F}
.kpi:nth-child(4){border-top-color:#2A3082}
.kpi:nth-child(5){border-top-color:#CC4534}
.kpi:nth-child(6){border-top-color:#5FC0EE}
.kpi:nth-child(7){border-top-color:#FAD30A}
.kpi-label{font-size:8.5px;font-weight:750;color:#7e8b94;text-transform:uppercase}
.kpi-value{font-size:20px;font-weight:760;color:#241460;margin-top:4px}
.phase-analysis{
 background:#fff;
 border:1px solid #dfe5eb;
 border-radius:12px;
 padding:15px 16px 14px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(36,20,96,.06)
}
.phase-analysis-head{
 display:flex;
 align-items:flex-start;
 justify-content:space-between;
 gap:14px;
 margin-bottom:11px
}
.phase-analysis-head h3{
 margin:0;
 color:#241460;
 font-size:22px;
 font-weight:850
}
.phase-analysis-head p{
 margin:4px 0 0;
 color:#68747d;
 font-size:13px;
 line-height:1.5
}
.phase-analysis-badge{
 flex:0 0 auto;
 font-size:11px;
 font-weight:850;
 color:#241460;
 background:#FAD30A;
 border:1px solid #FAD30A;
 border-radius:11px;
 padding:5px 8px
}
.phase-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px
}
.phase-card{
 border:1px solid #e2e7ec;
 border-radius:12px;
 padding:12px 13px;
 background:#fbfcfe;
 min-width:0;
 box-shadow:0 2px 8px rgba(36,20,96,.04)
}
.phase-card.coa{
 border-top:5px solid #2A3082;
 background:#ffffff;
 border-color:#d9dfe7
}
.phase-card.tit{
 border-top:5px solid #0FACF1;
 background:#ffffff;
 border-color:#d9dfe7
}
.phase-card .phase-label{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:8px;
 margin:-12px -13px 10px;
 padding:9px 12px;
 border-radius:8px 8px 0 0
}
.phase-card.coa .phase-label{
 background:#241460
}
.phase-card.tit .phase-label{
 background:#0FACF1
}
.phase-card.coa .phase-label b,
.phase-card.coa .phase-share{
 color:#ffffff
}
.phase-card.tit .phase-label b,
.phase-card.tit .phase-share{
 color:#241460
}
.phase-card .phase-label b{
 color:#241460;
 font-size:14px;
 font-weight:900;
 text-transform:uppercase;
 letter-spacing:.35px
}
.phase-card.coa .phase-label b{
 color:#241460
}
.phase-card.tit .phase-label b{
 color:#241460
}
.phase-card .phase-share{
 font-size:12px;
 font-weight:850;
 color:#0877A5
}
.phase-card.coa .phase-share{
 color:#241460
}
.phase-card.tit .phase-share{
 color:#0FACF1
}
/* Override institucional de encabezados de fase */
.phase-card.coa .phase-label b,
.phase-card.coa .phase-label .phase-share{
 color:#ffffff
}
.phase-card.tit .phase-label b,
.phase-card.tit .phase-label .phase-share{
 color:#241460
}
.phase-card .phase-amount{
 color:#241460;
 font-size:28px;
 font-weight:900;
 line-height:1.1;
 margin-bottom:8px
}
.phase-card.tit .phase-amount{
 color:#241460
}
.phase-card .phase-meta{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:7px
}
.phase-card .phase-meta div{
 background:#fff;
 border:1px solid #edf0f3;
 border-radius:8px;
 padding:7px 8px
}
.phase-card.coa .phase-meta div{
 background:#ffffff;
 border-color:#d9dfe7
}
.phase-card.tit .phase-meta div{
 background:#ffffff;
 border-color:#d9dfe7
}
.phase-card .phase-meta span{
 display:block;
 color:#7b8790;
 font-size:9.5px;
 font-weight:800;
 text-transform:uppercase;
 margin-bottom:2px
}
.phase-card .phase-meta strong{
 color:#241460;
 font-size:13px;
 font-weight:850
}
.phase-composition{
 margin-top:10px
}
.phase-bar{
 height:10px;
 display:flex;
 width:100%;
 overflow:hidden;
 border-radius:8px;
 background:#edf1f5
}
.phase-bar .coa{
 background:#2A3082;
 height:100%
}
.phase-bar .tit{
 background:#0FACF1;
 height:100%
}
.phase-legend{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:12px;
 margin-top:6px;
 font-size:11px;
 color:#5d6871
}
.phase-reading{
 margin-top:9px;
 padding:8px 10px;
 border-radius:8px;
 background:#f6f7fb;
 border-left:4px solid #FAD30A;
 color:#4d5862;
 font-size:12px;
 line-height:1.5
}
.phase-reading b{color:#241460}

.phase-state-block{
 margin-top:12px;
 padding-top:10px;
 border-top:1px solid #dfe5eb
}
.phase-state-title{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:8px;
 margin-bottom:7px
}
.phase-state-title b{
 color:#241460;
 font-size:12px;
 font-weight:900;
 text-transform:uppercase;
 letter-spacing:.25px
}
.phase-card.tit .phase-state-title b{
 color:#241460
}
.phase-state-title span{
 color:#6e7a84;
 font-size:10px;
 font-weight:700
}
.phase-state-row{
 background:#fff;
 border:1px solid #e5e9ee;
 border-radius:9px;
 padding:8px 9px;
 margin-bottom:6px
}
.phase-card.coa .phase-state-row{
 background:#ffffff;
 border-color:#d9dfe7;
 box-shadow:inset 4px 0 0 #241460
}
.phase-card.tit .phase-state-row{
 background:#ffffff;
 border-color:#d9dfe7;
 box-shadow:inset 4px 0 0 #0FACF1
}
.phase-state-main{
 display:flex;
 align-items:center;
 justify-content:space-between;
 gap:10px;
 margin-bottom:6px
}
.phase-state-name{
 color:#241460;
 font-size:11.5px;
 font-weight:900;
 line-height:1.25
}
.phase-card.tit .phase-state-name{
 color:#241460
}
.phase-state-pct{
 flex:0 0 auto;
 color:#0877A5;
 font-size:11px;
 font-weight:900
}
.phase-card.coa .phase-state-pct{
 color:#241460
}
.phase-card.tit .phase-state-pct{
 color:#0FACF1
}
.phase-state-metrics{
 display:grid;
 grid-template-columns:1.5fr .75fr .75fr 1.1fr;
 gap:6px
}
.phase-state-metrics div{
 min-width:0;
 background:#f7f9fb;
 border-radius:6px;
 padding:6px 7px
}
.phase-card.coa .phase-state-metrics div{
 background:#ffffff
}
.phase-card.tit .phase-state-metrics div{
 background:#ffffff
}
.phase-state-metrics span{
 display:block;
 color:#7a8791;
 font-size:8.5px;
 font-weight:800;
 text-transform:uppercase;
 margin-bottom:2px
}
.phase-state-metrics b{
 display:block;
 color:#241460;
 font-size:11px;
 font-weight:850;
 white-space:nowrap
}
.phase-state-empty{
 color:#6e7a84;
 background:#f7f9fb;
 border:1px dashed #cfd7df;
 border-radius:8px;
 padding:10px;
 font-size:11px;
 font-weight:700
}

.notif-unified{
 background:white;
 border:1px solid #dfe5eb;
 border-radius:12px;
 padding:16px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(36,20,96,.06)
}
.notif-head{
 display:flex;
 justify-content:space-between;
 align-items:flex-start;
 gap:16px;
 margin-bottom:11px
}
.notif-head h3{
 margin:0;
 color:#241460;
 font-size:21px;
 font-weight:800
}
.notif-head p{
 margin:5px 0 0;
 color:#68747d;
 font-size:12px;
 line-height:1.45
}
.notif-criterion{
 font-size:10.5px;
 font-weight:800;
 color:#241460;
 background:#eef8ff;
 border:1px solid #9edaf4;
 border-radius:12px;
 padding:6px 9px;
 white-space:nowrap
}

/* RESUMEN NOTIFICABLE / NO NOTIFICABLE */
.notif-kpis{
 display:grid;
 grid-template-columns:1.25fr .75fr;
 gap:10px;
 margin-bottom:9px
}
.notif-kpi{
 border-radius:10px;
 padding:15px 16px;
 border:1px solid #e3e8ed;
 background:#fafcfd
}
.notif-kpi.yes{border-top:5px solid #24694F}
.notif-kpi.no{border-top:5px solid #CC4534}
.notif-kpi .lbl{
 font-size:10.5px;
 font-weight:800;
 text-transform:uppercase;
 color:#69757f
}
.notif-kpi b{
 display:block;
 font-size:25px;
 color:#241460;
 margin-top:5px
}
.notif-kpi span{
 display:block;
 margin-top:5px;
 font-size:12px;
 color:#5f6b74;
 line-height:1.35
}
.notif-bar{
 display:flex;
 height:16px;
 border-radius:9px;
 overflow:hidden;
 background:#e9edf0;
 margin-bottom:12px
}
.notif-bar .yes{background:#24694F;height:100%}
.notif-bar .no{background:#CC4534;height:100%}

/* TRES DECISIONES */
.notif-quick{
 display:grid;
 grid-template-columns:1.25fr .75fr;
 gap:10px;
 align-items:stretch;
 margin:10px 0 12px
}
.notif-quick-main{
 background:linear-gradient(95deg,#241460 0%,#2A3082 62%,#0FACF1 100%);
 color:white;
 border-radius:10px;
 padding:12px 14px;
 min-width:0
}
.notif-quick-main .eyebrow{
 font-size:10px;
 font-weight:800;
 text-transform:uppercase;
 letter-spacing:.35px;
 opacity:.82
}
.notif-quick-main .headline{
 font-size:18px;
 font-weight:800;
 line-height:1.25;
 margin-top:4px
}
.notif-quick-main .headline strong{
 font-size:27px;
 color:white
}
.notif-quick-main .copy{
 font-size:11.5px;
 line-height:1.45;
 margin-top:5px;
 opacity:.92
}
.notif-quick-side{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px
}
.notif-quick-box{
 background:#fafcfd;
 border:1px solid #e3e8ed;
 border-radius:10px;
 padding:10px 11px;
 min-width:0
}
.notif-quick-box.direct{border-top:4px solid #24694F}
.notif-quick-box.improve{border-top:4px solid #FAD30A}
.notif-quick-box .lbl{
 display:block;
 font-size:10px;
 font-weight:800;
 text-transform:uppercase;
 color:#6c7881
}
.notif-quick-box b{
 display:block;
 font-size:18px;
 color:#241460;
 margin-top:4px
}
.notif-quick-box span{
 display:block;
 font-size:11px;
 color:#65717a;
 line-height:1.35;
 margin-top:3px
}
.notif-quick-split{
 display:flex;
 height:10px;
 border-radius:7px;
 overflow:hidden;
 background:#e7ebef;
 margin-top:7px
}
.notif-quick-split .direct{height:100%;background:#24694F}
.notif-quick-split .improve{height:100%;background:#FAD30A}

.notif-action-title{
 font-size:14px;
 font-weight:800;
 color:#241460;
 margin-bottom:3px
}
.notif-action-sub{
 font-size:11.5px;
 color:#6f7b84;
 margin-bottom:8px
}
.notif-action-grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:9px;
 margin-bottom:9px
}
.notif-action-card{
 border:1px solid #e4e9ed;
 border-radius:10px;
 padding:13px 14px;
 background:#fafcfd;
 min-width:0
}
.notif-action-card.direct{border-left:5px solid #24694F}
.notif-action-card.improve{border-left:5px solid #FAD30A}
.notif-action-card.blocked{border-left:5px solid #CC4534}
.notif-action-card .tag{
 display:inline-block;
 font-size:10px;
 font-weight:800;
 text-transform:uppercase;
 border-radius:9px;
 padding:4px 7px;
 margin-bottom:6px
}
.notif-action-card.direct .tag{background:#eaf5ef;color:#24694F}
.notif-action-card.improve .tag{background:#fff6c9;color:#725d00}
.notif-action-card.blocked .tag{background:#fdeceb;color:#a63b30}
.notif-action-card h4{
 margin:0;
 font-size:13px;
 color:#241460
}
.notif-action-card b{
 display:block;
 font-size:21px;
 color:#241460;
 margin-top:5px
}
.notif-action-card p{
 margin:5px 0 0;
 font-size:11.5px;
 color:#5d6871;
 line-height:1.4
}
.notif-action-card .meta{
 margin-top:7px;
 padding-top:7px;
 border-top:1px solid #e7ebef;
 font-size:10.5px;
 color:#707b84;
 line-height:1.4
}

/* CALIDAD DENTRO DE LO NOTIFICABLE */
.notif-quality{
 background:#f7f9fc;
 border:1px solid #e3e8ee;
 border-radius:10px;
 padding:10px 11px;
 margin-bottom:9px
}
.notif-quality-head{
 display:flex;
 justify-content:space-between;
 gap:12px;
 align-items:center;
 margin-bottom:8px
}
.notif-quality-head h4{
 margin:0;
 font-size:13px;
 color:#241460
}
.notif-quality-head span{
 font-size:10.5px;
 color:#6f7b84
}
.notif-quality-grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:7px
}
.notif-quality-card{
 background:white;
 border:1px solid #e4e9ee;
 border-radius:8px;
 padding:10px 11px
}
.notif-quality-card.coords{border-top:4px solid #FAD30A}
.notif-quality-card.parish{border-top:4px solid #0FACF1}
.notif-quality-card.sector{border-top:4px solid #2A3082}
.notif-quality-card .lbl{
 font-size:10px;
 font-weight:800;
 text-transform:uppercase;
 color:#68757f
}
.notif-quality-card b{
 display:block;
 font-size:17px;
 color:#241460;
 margin-top:3px
}
.notif-quality-card span{
 display:block;
 font-size:10.8px;
 color:#6b767f;
 line-height:1.35;
 margin-top:3px
}
.notif-action-bar{
 display:flex;
 height:12px;
 border-radius:8px;
 overflow:hidden;
 background:#e9edf0;
 margin-bottom:9px
}
.notif-action-bar .direct{background:#24694F;height:100%}
.notif-action-bar .improve{background:#FAD30A;height:100%}
.notif-action-bar .blocked{background:#CC4534;height:100%}

/* DECISIÓN */
.notif-decision{
 background:linear-gradient(90deg,#eef8ff,#f8f9ff);
 border-left:5px solid #0FACF1;
 border-radius:8px;
 padding:10px 12px
}
.notif-decision .title{
 font-size:13px;
 font-weight:800;
 color:#241460
}
.notif-decision .text{
 font-size:11.5px;
 line-height:1.45;
 color:#4c5963;
 margin-top:3px
}
.notif-decision .legend{
 margin-top:6px;
 font-size:10.5px;
 color:#6e7982
}

.geo-unified{
 background:white;
 border:1px solid #dfe8ed;
 border-radius:12px;
 padding:14px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(0,0,0,.05)
}
.geo-unified-head{
 display:flex;
 justify-content:space-between;
 align-items:flex-start;
 gap:16px;
 margin-bottom:11px
}
.geo-unified-head h3{
 margin:0;
 color:#241460;
 font-size:18px;
 font-weight:800
}
.geo-unified-head p{
 margin:4px 0 0;
 color:#737f88;
 font-size:10px;
 line-height:1.45
}
.geo-unified-criterion{
