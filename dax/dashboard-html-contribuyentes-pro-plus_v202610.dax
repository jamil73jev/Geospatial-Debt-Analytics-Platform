 font-weight:800;
 color:#075878;
 background:#eaf8fd;
 border:1px solid #b9e3f2;
 border-radius:12px;
 padding:6px 9px;
 white-space:nowrap
}
.geo-unified-kpis{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin-bottom:10px
}
.geo-unified-kpi{
 border-radius:10px;
 padding:13px 14px;
 border:1px solid #e5ebef;
 background:#fafcfd
}
.geo-unified-kpi.geo{border-top:5px solid #24694F}
.geo-unified-kpi.nogeo{border-top:5px solid #CC4534}
