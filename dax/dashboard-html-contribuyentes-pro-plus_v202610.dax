                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
            </tr>",

        "",
        DIVIDE ( [__CarteraSector], [__PresenciasSector], 0 ), DESC,
        [__CarteraSector], DESC,
        [__PresenciasSector], ASC,
        [__PrioridadSector], DESC,
        'GEOREFERENCIACION'[SectorNomenclatura], ASC
    )




/* ============================================================
   REVISAR UBICACIÓN · DESGLOSE TERRITORIAL OPTIMIZADO

   Se reincorpora al final del análisis territorial el desglose:
   01. SIN UBICACION
   02. SIN COORDENADAS
   03. SIN PARROQUIA
   04. SIN SECTOR

   Optimización:
   - Se construye UNA sola tabla virtual por:
       IdContribuyente + Fase + CalidadUbicacion
   - El segmento Crítico/Alto/Medio/Bajo se reutiliza desde
     _ContribuyentesBase.
   - GENERAL / TÍTULOS / COACTIVA reutilizan la misma base.
   - El mismo resultado se reutiliza en PARROQUIA y SECTOR.
   ============================================================ */

VAR _BrechasCatalogo =
    DATATABLE (
        "__Orden", INTEGER,
        "__Codigo", STRING,
        "__Etiqueta", STRING,
        "__Calidad", STRING,
        {
            { 1, "01", "SIN UBICACIÓN",    "01. SIN UBICACION" },
            { 2, "02", "SIN COORDENADAS",  "02. SIN COORDENADAS" },
            { 3, "03", "SIN PARROQUIA",    "03. SIN PARROQUIA" },
            { 4, "04", "SIN SECTOR",       "04. SIN SECTOR" }
        }
    )

VAR _BrechaPorContribuyenteFaseCalidad =
    CALCULATETABLE (
        SUMMARIZECOLUMNS (
            'GEOREFERENCIACION'[IdContribuyente],
            'GEOREFERENCIACION'[CodFaseDeuda],
            'GEOREFERENCIACION'[CalidadUbicacion],
            "__MontoBrecha",
                SUM ( 'GEOREFERENCIACION'[ValorTotal] )
        ),
        KEEPFILTERS ( _FiltroCartera ),
        TREATAS (
            {
                "01. SIN UBICACION",
                "02. SIN COORDENADAS",
                "03. SIN PARROQUIA",
                "04. SIN SECTOR"
            },
            'GEOREFERENCIACION'[CalidadUbicacion]
        )
    )

VAR _MapaSegmentoBrecha =
    SELECTCOLUMNS (
        _ContribuyentesBase,
        "IdContribuyente",
            'GEOREFERENCIACION'[IdContribuyente],
        "__SegmentoBrecha",
            [__Segmento]
    )

VAR _BrechaDetalle =
    NATURALINNERJOIN (
        SELECTCOLUMNS (
            _BrechaPorContribuyenteFaseCalidad,
            "IdContribuyente",
                'GEOREFERENCIACION'[IdContribuyente],
            "CodFaseDeuda",
                'GEOREFERENCIACION'[CodFaseDeuda],
            "CalidadBrecha",
                'GEOREFERENCIACION'[CalidadUbicacion],
            "__MontoBrecha",
                [__MontoBrecha]
        ),
        _MapaSegmentoBrecha
    )

VAR _BrechaDetalle_GENERAL =
    _BrechaDetalle

VAR _BrechaDetalle_TIT =
    FILTER (
        _BrechaDetalle,
        [CodFaseDeuda] = "TIT"
    )

VAR _BrechaDetalle_COA =
    FILTER (
        _BrechaDetalle,
        [CodFaseDeuda] = "COA"
    )

VAR _HtmlResumenBrechas_GENERAL =
    VAR _CritRows =
        FILTER ( _BrechaDetalle_GENERAL, [__SegmentoBrecha] = "CRITICO" )
    VAR _AltRows =
        FILTER ( _BrechaDetalle_GENERAL, [__SegmentoBrecha] = "ALTO" )
    VAR _MedRows =
        FILTER ( _BrechaDetalle_GENERAL, [__SegmentoBrecha] = "MEDIO" )
    VAR _BajRows =
        FILTER ( _BrechaDetalle_GENERAL, [__SegmentoBrecha] = "BAJO" )

    VAR _Crit = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _CritRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Alt  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _AltRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Med  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _MedRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Baj  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _BajRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )

    VAR _MontoCrit = SUMX ( _CritRows, [__MontoBrecha] )
    VAR _MontoAlt  = SUMX ( _AltRows, [__MontoBrecha] )
    VAR _MontoMed  = SUMX ( _MedRows, [__MontoBrecha] )
    VAR _MontoBaj  = SUMX ( _BajRows, [__MontoBrecha] )

    VAR _TotalCont = _Crit + _Alt + _Med + _Baj

    VAR _ClaseRiesgo =
        "seg-review-parent seg-risk-row"
            & IF ( _Crit > 0, " has-critical", "" )
            & IF ( _Alt > 0, " has-high", "" )
            & IF ( _Med > 0, " has-medium", "" )
            & IF ( _Baj > 0, " has-low", "" )

    RETURN
        IF (
            _TotalCont > 0,
            "<tr class='" & _ClaseRiesgo & "'>
                <td class='seg-parr-name'>
                    <span class='seg-review-icon'>&#9662;</span>
                    REVISAR UBICACIÓN
                    <span class='seg-review-sub'>Sin ubicación, coordenadas, parroquia o sector · GENERAL</span>
                </td>
                <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>

                <td class='seg-num total seg-dynamic'
                    data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                    data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                    data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                    data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                    data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                    data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                    data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                    data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                    data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                    data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                    data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                    data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                    data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                    data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                    data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>

                <td class='seg-money seg-dynamic'
                    data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( _MontoAlt, "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( _MontoMed, "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( _MontoBaj, "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( _MontoCrit + _MontoAlt, "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( _MontoCrit + _MontoMed, "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( _MontoCrit + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>

                <td class='seg-average seg-dynamic'
                    data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
            </tr>",
            ""
        )

VAR _HtmlDetalleBrechas_GENERAL =
    CONCATENATEX (
        _BrechasCatalogo,

        VAR _CalidadActual = [__Calidad]

        VAR _RowsCalidad =
            FILTER (
                _BrechaDetalle_GENERAL,
                [CalidadBrecha] = _CalidadActual
            )

        VAR _CritRows =
            FILTER ( _RowsCalidad, [__SegmentoBrecha] = "CRITICO" )
        VAR _AltRows =
            FILTER ( _RowsCalidad, [__SegmentoBrecha] = "ALTO" )
        VAR _MedRows =
            FILTER ( _RowsCalidad, [__SegmentoBrecha] = "MEDIO" )
        VAR _BajRows =
            FILTER ( _RowsCalidad, [__SegmentoBrecha] = "BAJO" )

        VAR _Crit = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _CritRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
        VAR _Alt  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _AltRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
        VAR _Med  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _MedRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
        VAR _Baj  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _BajRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )

        VAR _MontoCrit = SUMX ( _CritRows, [__MontoBrecha] )
        VAR _MontoAlt  = SUMX ( _AltRows, [__MontoBrecha] )
        VAR _MontoMed  = SUMX ( _MedRows, [__MontoBrecha] )
        VAR _MontoBaj  = SUMX ( _BajRows, [__MontoBrecha] )

        VAR _TotalCont = _Crit + _Alt + _Med + _Baj

        VAR _ClaseRiesgo =
            "seg-review-child seg-risk-row"
                & IF ( _Crit > 0, " has-critical", "" )
                & IF ( _Alt > 0, " has-high", "" )
                & IF ( _Med > 0, " has-medium", "" )
                & IF ( _Baj > 0, " has-low", "" )

        RETURN
            IF (
                _TotalCont > 0,
                "<tr class='" & _ClaseRiesgo & "'>
                    <td class='seg-parr-name'>
                        <span class='seg-child-line'>└─</span>
                        <span class='seg-status-code'>" & [__Codigo] & "</span>" &
                        [__Etiqueta] &
                    "</td>
                    <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                    <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                    <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                    <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>

                    <td class='seg-num total seg-dynamic'
                        data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                        data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                        data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                        data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                        data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                        data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                        data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                        data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                        data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                        data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                        data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                        data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                        data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                        data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                        data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>

                    <td class='seg-money seg-dynamic'
                        data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
                        data-h='" & FORMAT ( _MontoAlt, "$ #,##0.00" ) & "'
                        data-m='" & FORMAT ( _MontoMed, "$ #,##0.00" ) & "'
                        data-l='" & FORMAT ( _MontoBaj, "$ #,##0.00" ) & "'
                        data-ch='" & FORMAT ( _MontoCrit + _MontoAlt, "$ #,##0.00" ) & "'
                        data-cm='" & FORMAT ( _MontoCrit + _MontoMed, "$ #,##0.00" ) & "'
                        data-cl='" & FORMAT ( _MontoCrit + _MontoBaj, "$ #,##0.00" ) & "'
                        data-hm='" & FORMAT ( _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                        data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                        data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                        data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                        data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                        data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>

                    <td class='seg-average seg-dynamic'
                        data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                        data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                        data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                        data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                        data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                        data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                        data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
                </tr>",
                ""
            ),

        "",
        [__Orden], ASC
    )

VAR _HtmlBrechas_GENERAL =
    _HtmlResumenBrechas_GENERAL
        & _HtmlDetalleBrechas_GENERAL

VAR _HtmlResumenBrechas_TIT =
    VAR _CritRows =
        FILTER ( _BrechaDetalle_TIT, [__SegmentoBrecha] = "CRITICO" )
    VAR _AltRows =
        FILTER ( _BrechaDetalle_TIT, [__SegmentoBrecha] = "ALTO" )
    VAR _MedRows =
        FILTER ( _BrechaDetalle_TIT, [__SegmentoBrecha] = "MEDIO" )
    VAR _BajRows =
        FILTER ( _BrechaDetalle_TIT, [__SegmentoBrecha] = "BAJO" )

    VAR _Crit = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _CritRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Alt  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _AltRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Med  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _MedRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )
    VAR _Baj  = COUNTROWS (
            DISTINCT (
                SELECTCOLUMNS (
                    _BajRows,
                    "__Id",
                        [IdContribuyente]
                )
            )
        )

    VAR _MontoCrit = SUMX ( _CritRows, [__MontoBrecha] )
    VAR _MontoAlt  = SUMX ( _AltRows, [__MontoBrecha] )
    VAR _MontoMed  = SUMX ( _MedRows, [__MontoBrecha] )
    VAR _MontoBaj  = SUMX ( _BajRows, [__MontoBrecha] )

    VAR _TotalCont = _Crit + _Alt + _Med + _Baj

    VAR _ClaseRiesgo =
        "seg-review-parent seg-risk-row"
            & IF ( _Crit > 0, " has-critical", "" )
            & IF ( _Alt > 0, " has-high", "" )
            & IF ( _Med > 0, " has-medium", "" )
            & IF ( _Baj > 0, " has-low", "" )

    RETURN
        IF (
            _TotalCont > 0,
            "<tr class='" & _ClaseRiesgo & "'>
                <td class='seg-parr-name'>
                    <span class='seg-review-icon'>&#9662;</span>
                    REVISAR UBICACIÓN
                    <span class='seg-review-sub'>Sin ubicación, coordenadas, parroquia o sector · TÍTULOS</span>
                </td>
                <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>

                <td class='seg-num total seg-dynamic'
                    data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                    data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                    data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                    data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                    data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                    data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                    data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                    data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                    data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                    data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                    data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                    data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                    data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                    data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                    data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>

                <td class='seg-money seg-dynamic'
                    data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
