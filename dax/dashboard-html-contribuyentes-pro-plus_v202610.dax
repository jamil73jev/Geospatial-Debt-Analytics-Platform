 font-size:8.5px;
 font-weight:800;
 text-transform:uppercase;
 color:#78848d
}
.geo-unified-kpi b{
 display:block;
 font-size:22px;
 color:#241460;
 margin-top:5px
}
.geo-unified-kpi span{
 display:block;
 margin-top:3px;
 font-size:9.5px;
 color:#68747d
}
.geo-location-split{
 margin-top:10px;
 margin-bottom:10px
}
.geo-location-title{
 font-size:10.5px;
 font-weight:800;
 color:#241460;
 margin-bottom:7px
}
.geo-location-sub{
 font-size:9px;
 color:#737f88;
 margin-bottom:8px
}
.geo-location-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:9px;
 margin-bottom:9px
}
.geo-location-card{
 border-radius:10px;
 padding:11px 12px;
 border:1px solid #e5ebef;
 background:#fafcfd
}
.geo-location-card.has{border-left:5px solid #FAD30A}
.geo-location-card.none{border-left:5px solid #CC4534}
.geo-location-card .lbl{
 font-size:8.5px;
 font-weight:800;
 text-transform:uppercase;
 color:#6f7c85
}
.geo-location-card b{
 display:block;
 font-size:18px;
 color:#241460;
 margin-top:4px
}
.geo-location-card span{
 display:block;
 font-size:9.5px;
 color:#66727b;
 margin-top:3px;
 line-height:1.35
}
.geo-quality-compact{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:7px;
 margin-top:8px
}
.geo-quality-chip{
 background:#f6f8fa;
 border:1px solid #e6ebef;
 border-radius:8px;
 padding:8px 9px
}
.geo-quality-chip .q-label{
 display:block;
 font-size:8px;
 font-weight:750;
 color:#707d86
}
.geo-quality-chip b{
 display:block;
 margin-top:3px;
 font-size:11px;
 color:#241460
}
.geo-location-decision{
 margin-top:9px;
 background:linear-gradient(90deg,#fff8e8,#f9fbff);
 border-left:4px solid #FAD30A;
 border-radius:8px;
 padding:9px 11px
}
.geo-location-decision .d-title{
 font-size:9.5px;
 font-weight:800;
 color:#241460
}
.geo-location-decision .d-text{
 font-size:9px;
 line-height:1.45;
 color:#4d5a64;
 margin-top:3px
}

.geo-unified-bar{
 display:flex;
 height:18px;
 border-radius:10px;
 overflow:hidden;
 background:#e9edf0;
 margin-bottom:10px
}
.geo-unified-bar .geo{
 background:#24694F;
 height:100%
}
.geo-unified-bar .nogeo{
 background:#CC4534;
 height:100%
}
.geo-unified-decision{
 display:grid;
 grid-template-columns:1.2fr .8fr;
 gap:12px;
 align-items:center;
 background:linear-gradient(90deg,#eef8ff,#f8fbff);
 border-left:5px solid #0FACF1;
 border-radius:9px;
 padding:11px 13px
}
.geo-unified-decision .title{
 font-size:10px;
 font-weight:800;
 color:#241460
}
.geo-unified-decision .text{
 font-size:9.5px;
 line-height:1.45;
 color:#43515b;
