Dashboard_HTML_Contribuyentes_Pro_Plus = 
VAR _EstadosCartera =
    {
        ( "COA", "O - JUICIO POR DICTARSE MEDIDA" ),
        ( "COA", "E1 - ESCRITO ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "D - HISTORIA DE DOMINIO" ),
        ( "COA", "Z - RETENCION DE CUENTAS" ),
        ( "COA", "D1 - HISTORIA DE DOMINIO ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "O1 - ACUMULACION DE JUICIOS /BOLETA DE COMPARECENCIA" ),
        ( "COA", "H - NO CITADO" ),
        ( "COA", "T - AUTOS IMPRESO" ),
        ( "COA", "P - SORTEADO" ),
        ( "COA", "E - ESCRITO CON EXCEPCION- RESOLUCION" ),
        ( "COA", "M - EMBARGO DE CUENTAS" ),
        ( "COA", "W - CONVENIO DE PAGO O COMPROMISO DE PAGO" ),
        ( "COA", "L - EMBARGO DE INMUEBLE EJECUTADO" ),
        ( "COA", "D2 - HISTORIA DE DOMINIO RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "Z2 - ACTUALIZACION DE MEDIDA DE RETENCIÓN" ),
        ( "COA", "Y1 - PREDIO CON JUICIO DE EXPROPIACION ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "Z1 - RETENCION DE CUENTAS ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "E2 - ESCRITO RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "L3 - EMBARGO DE INMUEBLE EJECUTADO CASILLERO JUDICIAL" ),
        ( "COA", "Y - PREDIO CON JUICIO DE EXPROPIACION" ),
        ( "COA", "E3 - ESCRITO CON CASILLERO JUDICIAL O CORREO ELECTRONICO" ),
        ( "COA", "Y2 - PREDIO CON JUICIO DE EXPROPIACION RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "S - EMBARGO INSCRITO EN EL REG DE LA PROPIEDAD" ),
        ( "COA", "A - AVALUO PERICIAL" ),
        ( "COA", "Q - HISTORIA DE DOMINIO CON GRAVAMEN" ),
        ( "COA", "J - CITADO" ),
        ( "COA", "F - TRIBUNAL FISCAL" ),
        ( "COA", "B - PROHIBICION DE ENAJENAR VEHICULOS/INMUEBLE DEL COACTIVADO" ),
        ( "COA", "B1 - PROHIBICION DE ENAJENAR VEHICULOS/INMUEBLE DEL COACTIVADO ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "U - PREDIO INEMBARGABLE" ),
        ( "COA", "S1 - EMBARGO INSCRITO EN EL REG DE LA PROPIEDAD ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "L1 - EMBARGO DE INMUEBLE EJECUTADO ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "M1 - EMBARGO DE CUENTAS ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "A1 - AVALUO PERICIAL ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "R1 - REMATE ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "W1 - CONVENIO DE PAGO O COMPROMISO DE PAGO ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "Q1 - HISTORIA DE DOMINIO CON GRAVAMEN ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "G - INSCRIBIR EMBARGO EN REGISTRADOR DE LA PROPIEDAD" ),
        ( "COA", "K - HISTORIA DE DOMINIO SIN GRAVAMEN" ),
        ( "COA", "K1 - HISTORIA DE DOMINIO SIN GRAVAMEN ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "G1 - INSCRIBIR EMBARGO EN REGISTRADOR DE LA PROPIEDAD ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "M2 - EMBARGO DE CUENTAS RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "B2 - PROHIBICION DE ENAJENAR VEHICULOS/INMUEBLE DEL COACTIVADO RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "L2 - EMBARGO DE INMUEBLE EJECUTADO RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "Q2 - HISTORIA DE DOMINIO CON GRAVAMEN RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "F1 - TRIBUNAL FISCAL ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "U1 - PREDIO INEMBARGABLE ENVIO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "K2 - HISTORIA DE DOMINIO SIN GRAVAMEN RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "V - ORDEN DE EMBARGO VEHICULO" ),
        ( "COA", "W2 - CONVENIO DE PAGO O COMPROMISO DE PAGO RECIBO DE OFICIO INTERNOS Y EXTERNOS" ),
        ( "COA", "A3 - AVALUO PERICIAL CASILLERO JUDICIAL" ),
        ( "TIT", "RET - TITULO DE CREDITO EN ESPERA DE RESOLUCION" ),
        ( "TIT", "TIN - INGRESO RAZON DE NO RECEPCION DE TÍTULO DE CRÉDITO" ),
        ( "TIT", "COA - ENVIADO A COACTIVA" ),
        ( "TIT", "TIS - INGRESO RAZON DE RECEPCION INDIVIDUAL DE TÍTULO DE CRÉDITO" ),
        ( "TIT", "NIT - NOTIFICACIÓN INDIVIDUAL DE TÍTULO DE CRÉDITO" ),
        ( "TIT", "GAT - GENERACIÓN AUTOMÁTICA DE TÍTULO DE CRÉDITO" ),
        ( "TIT", "RTF - RESOLUCION DE TITULO DE CREDITO FAVORABLE PARA LA BAJA" ),
        ( "TIT", "PGT - PENDIENTE NOTIFICACION POR GACETA TRIBUTARIA DIGITAL DE TITULO DE CREDITO" )
    }

VAR _FiltroCartera =
    TREATAS (
        _EstadosCartera,
        'GEOREFERENCIACION'[CodFaseDeuda],
        'GEOREFERENCIACION'[EstadoEspecifico]
    )
VAR _ContribuyentesBaseRaw =
    FILTER (
        CALCULATETABLE (
            SUMMARIZECOLUMNS (
                'GEOREFERENCIACION'[IdContribuyente],
                "__Obligaciones",
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
                "__Deuda",
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] )
            ),
            KEEPFILTERS ( _FiltroCartera )
        ),
        [__Deuda] > 0
    )

VAR _ContribuyentesBase =
    ADDCOLUMNS (
        _ContribuyentesBaseRaw,
        "__Segmento",
            SWITCH (
                TRUE (),
                [__Deuda] >= 10000 || [__Obligaciones] >= 11, "CRITICO",
                [__Deuda] >= 5000  || [__Obligaciones] >= 6,  "ALTO",
                [__Deuda] >= 1000  || [__Obligaciones] >= 4,  "MEDIO",
                "BAJO"
            )
    )
VAR _Contribuyentes =
    COUNTROWS ( _ContribuyentesBase )

VAR _Cartera =
    SUMX ( _ContribuyentesBase, [__Deuda] )

VAR _Obligaciones =
    SUMX ( _ContribuyentesBase, [__Obligaciones] )

VAR _DeudaPromedio =
    DIVIDE ( _Cartera, _Contribuyentes, 0 )

VAR _ObligPromedio =
    DIVIDE ( _Obligaciones, _Contribuyentes, 0 )

VAR _MayorExposicion =
    MAXX ( _ContribuyentesBase, [__Deuda] )

VAR _FiltroNotificableHoy =
    TREATAS (
        {
            "02. SIN COORDENADAS",
            "03. SIN PARROQUIA",
            "04. SIN SECTOR",
            "05. UBICACION COMPLETA"
        },
        'GEOREFERENCIACION'[CalidadUbicacion]
    )
VAR _FiltroNoNotificableHoy =
    TREATAS (
        { "01. SIN UBICACION" },
        'GEOREFERENCIACION'[CalidadUbicacion]
    )
VAR _CarteraNotificableHoy =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( _FiltroNotificableHoy )
    )

VAR _CarteraNoNotificableHoy =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( _FiltroNoNotificableHoy )
    )

VAR _PctCarteraNotificableHoy =
    DIVIDE ( _CarteraNotificableHoy, _Cartera, 0 )

VAR _PctCarteraNoNotificableHoy =
    DIVIDE ( _CarteraNoNotificableHoy, _Cartera, 0 )

VAR _ObligNotificablesHoy =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( _FiltroNotificableHoy )
    )

VAR _ObligNoNotificablesHoy =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( _FiltroNoNotificableHoy )
    )

/* ============================================================
   CONTRIBUYENTES · CLASIFICACIÓN EXCLUSIVA
   - Notificable: tiene al menos una obligación en 02/03/04/05
   - No notificable: no tiene ninguna notificable y sí tiene 01
   ============================================================ */
VAR _ContribNotificablesHoy =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( _FiltroNotificableHoy )
    )
VAR _ContribNoNotificablesHoy =
    MAX (
        0,
        _Contribuyentes - _ContribNotificablesHoy
    )
VAR _PctContribNotificablesHoy =
    DIVIDE ( _ContribNotificablesHoy, _Contribuyentes, 0 )

VAR _CarteraUbicacionCompleta =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "05. UBICACION COMPLETA"
        )
    )

VAR _CarteraSinCoordenadas =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "02. SIN COORDENADAS"
        )
    )

VAR _CarteraSinParroquia =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "03. SIN PARROQUIA"
        )
    )

VAR _CarteraSinSector =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "04. SIN SECTOR"
        )
    )

VAR _ObligUbicacionCompleta =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "05. UBICACION COMPLETA"
        )
    )

VAR _ObligSinCoordenadas =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "02. SIN COORDENADAS"
        )
    )

VAR _ObligSinParroquia =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "03. SIN PARROQUIA"
        )
    )

VAR _ObligSinSector =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "04. SIN SECTOR"
        )
    )

VAR _ContUbicacionCompleta =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "05. UBICACION COMPLETA"
        )
    )

VAR _ContSinCoordenadas =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "02. SIN COORDENADAS"
        )
    )

VAR _ContSinParroquia =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "03. SIN PARROQUIA"
        )
    )

VAR _ContSinSector =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS (
            'GEOREFERENCIACION'[CalidadUbicacion]
                = "04. SIN SECTOR"
        )
    )

VAR _CarteraNotificableIncompleta =
    _CarteraSinCoordenadas
        + _CarteraSinParroquia
        + _CarteraSinSector

VAR _PctDirectoDentroNotificable =
    DIVIDE (
        _CarteraUbicacionCompleta,
        _CarteraNotificableHoy,
        0
    )

VAR _PctMejoraDentroNotificable =
    DIVIDE (
        _CarteraNotificableIncompleta,
        _CarteraNotificableHoy,
        0
    )

VAR _WDirectoDentroNotificable =
    SUBSTITUTE (
        FORMAT ( _PctDirectoDentroNotificable * 100, "0.0" ),
        ",",
        "."
    )

VAR _WMejoraDentroNotificable =
    SUBSTITUTE (
        FORMAT ( _PctMejoraDentroNotificable * 100, "0.0" ),
        ",",
        "."
    )

VAR _MensajeNotificacionEjecutivo =
    FORMAT ( _PctCarteraNotificableHoy, "0.0%" ) &
    " de la cartera es ubicable y puede incorporarse al proceso de notificación. " &
    "Dentro de ese universo, " &
    FORMAT ( _PctDirectoDentroNotificable, "0.0%" ) &
    " está listo sin corrección territorial y " &
    FORMAT ( _PctMejoraDentroNotificable, "0.0%" ) &
    " puede notificarse mientras se mejoran coordenadas, parroquia o sector."


/* ============================================================
   LECTURA EJECUTIVA DE ACCIÓN
   Tres decisiones operativas:
   A. NOTIFICAR YA       -> 05. UBICACION COMPLETA
   B. NOTIFICAR + DEPURAR -> 02 / 03 / 04
   C. INVESTIGAR          -> 01. SIN UBICACION

   Las tres carteras son excluyentes y suman el 100%.
   ============================================================ */
VAR _PctAccionNotificarYa =
    DIVIDE ( _CarteraUbicacionCompleta, _Cartera, 0 )

VAR _PctAccionNotificarDepurar =
    DIVIDE ( _CarteraNotificableIncompleta, _Cartera, 0 )

VAR _PctAccionInvestigar =
    DIVIDE ( _CarteraNoNotificableHoy, _Cartera, 0 )

VAR _ObligNotificarDepurar =
    MAX ( 0, _ObligNotificablesHoy - _ObligUbicacionCompleta )

VAR _WAccionNotificarYa =
    SUBSTITUTE (
        FORMAT ( _PctAccionNotificarYa * 100, "0.0" ),
        ",",
        "."
    )

VAR _WAccionNotificarDepurar =
    SUBSTITUTE (
        FORMAT ( _PctAccionNotificarDepurar * 100, "0.0" ),
        ",",
        "."
    )

VAR _WAccionInvestigar =
    SUBSTITUTE (
        FORMAT ( _PctAccionInvestigar * 100, "0.0" ),
        ",",
        "."
    )

VAR _DecisionEjecutivaNotificacion =
    SWITCH (
        TRUE (),
        _PctAccionInvestigar >= 0.25,
            "REDUCIR LA CARTERA BLOQUEADA POR FALTA DE UBICACIÓN",
        _PctAccionNotificarDepurar >= _PctAccionNotificarYa,
            "NOTIFICAR Y DEPURAR EN PARALELO",
        "ESCALAR LA NOTIFICACIÓN SOBRE LA CARTERA YA UBICABLE"
    )

VAR _MensajeEjecutivoNotificacion =
    FORMAT ( _PctCarteraNotificableHoy, "0.0%" ) &
    " de la cartera puede entrar al proceso de notificación con la información disponible. " &
    FORMAT ( _PctAccionNotificarYa, "0.0%" ) &
    " está lista sin corrección territorial; " &
    FORMAT ( _PctAccionNotificarDepurar, "0.0%" ) &
    " puede notificarse pero requiere mejorar coordenadas, parroquia o sector; y solo " &
    FORMAT ( _PctAccionInvestigar, "0.0%" ) &
    " está bloqueada por ausencia de ubicación."

/* Barras */
VAR _WNotificable =
    SUBSTITUTE (
        FORMAT ( _PctCarteraNotificableHoy * 100, "0.0" ),
        ",",
        "."
    )

VAR _WNoNotificable =
    SUBSTITUTE (
        FORMAT ( _PctCarteraNoNotificableHoy * 100, "0.0" ),
        ",",
        "."
    )

VAR _RubrosNoNotificablesBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'GEOREFERENCIACION'[TipoDeuda] ),
                KEEPFILTERS ( _FiltroCartera ),
                KEEPFILTERS ( _FiltroNoNotificableHoy )
            ),

            "__MontoNoNotif",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( _FiltroNoNotificableHoy )
                ),

            "__ObligNoNotif",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( _FiltroNoNotificableHoy )
                ),

            "__ContNoNotif",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( _FiltroNoNotificableHoy )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[TipoDeuda] )
            && [__MontoNoNotif] > 0
    )

VAR _CantidadRubrosNoNotificables =
    COUNTROWS ( _RubrosNoNotificablesBase )

VAR _HtmlRubrosNoNotificables =
    CONCATENATEX (
        _RubrosNoNotificablesBase,

        VAR _Rubro =
            'GEOREFERENCIACION'[TipoDeuda]

        VAR _Monto =
            [__MontoNoNotif]

        VAR _Oblig =
            [__ObligNoNotif]

        VAR _Cont =
            [__ContNoNotif]

        VAR _Pct =
            DIVIDE (
                _Monto,
                _CarteraNoNotificableHoy,
                0
            )

        RETURN
            "<tr>
                <td class='nogeo-rubro' title='" &
                    _Rubro & "'>" & _Rubro & "</td>
                <td class='num'>" &
                    FORMAT ( _Oblig, "#,##0" ) & "</td>
                <td class='num'>" &
                    FORMAT ( _Cont, "#,##0" ) & "</td>
                <td class='money strong'>" &
                    FORMAT ( _Monto, "$ #,##0.00" ) & "</td>
                <td class='center'>" &
                    FORMAT ( _Pct, "0.00%" ) & "</td>
            </tr>",

        "",
        [__MontoNoNotif], DESC,
        'GEOREFERENCIACION'[TipoDeuda], ASC
    )

VAR _CarteraCoactivaTotal =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
    )
VAR _CarteraTitulosTotal =
    CALCULATE (
        SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
    )
VAR _PctCarteraCoactivaTotal =
    DIVIDE (
        _CarteraCoactivaTotal,
        _Cartera,
        0
    )

VAR _PctCarteraTitulosTotal =
    DIVIDE (
        _CarteraTitulosTotal,
        _Cartera,
        0
    )

VAR _ObligacionesCoactivaTotal =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
    )
VAR _ObligacionesTitulosTotal =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
    )
VAR _ContribuyentesCoactivaTotal =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
    )
VAR _ContribuyentesTitulosTotal =
    CALCULATE (
        DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
        KEEPFILTERS ( _FiltroCartera ),
        KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
    )
VAR _PromedioCoactivaPorContribuyente =
    DIVIDE (
        _CarteraCoactivaTotal,
        _ContribuyentesCoactivaTotal,
        0
    )

VAR _PromedioTitulosPorContribuyente =
    DIVIDE (
        _CarteraTitulosTotal,
        _ContribuyentesTitulosTotal,
        0
    )

/* ============================================================
   DESGLOSE POR ESTADO SELECCIONADO · COACTIVA
   ============================================================ */
VAR _EstadosCoactivaBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'GEOREFERENCIACION'[EstadoEspecifico] ),
                KEEPFILTERS ( _FiltroCartera ),
                KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
            ),
            "__MontoEstado",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
                ),
            "__ObligEstado",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
                ),
            "__ContEstado",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "COA" )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[EstadoEspecifico] )
            && TRIM ( 'GEOREFERENCIACION'[EstadoEspecifico] & "" ) <> ""
            && [__MontoEstado] > 0
    )

VAR _HtmlEstadosCoactiva =
    IF (
        COUNTROWS ( _EstadosCoactivaBase ) = 0,
        "<div class='phase-state-empty'>Sin cartera de Coactiva para los estados seleccionados.</div>",
        CONCATENATEX (
            _EstadosCoactivaBase,
            VAR _Estado = TRIM ( 'GEOREFERENCIACION'[EstadoEspecifico] & "" )
            VAR _Monto = [__MontoEstado]
            VAR _Oblig = [__ObligEstado]
            VAR _Cont = [__ContEstado]
            VAR _Pct = DIVIDE ( _Monto, _CarteraCoactivaTotal, 0 )
            VAR _Prom = DIVIDE ( _Monto, _Cont, 0 )
            RETURN
                "<div class='phase-state-row'>
                    <div class='phase-state-main'>
                        <span class='phase-state-name'>" & _Estado & "</span>
                        <span class='phase-state-pct'>" & FORMAT ( _Pct, "0.0%" ) & "</span>
                    </div>
                    <div class='phase-state-metrics'>
                        <div><span>Cartera</span><b>" & FORMAT ( _Monto, "$ #,##0.00" ) & "</b></div>
                        <div><span>Contrib.</span><b>" & FORMAT ( _Cont, "#,##0" ) & "</b></div>
                        <div><span>Oblig.</span><b>" & FORMAT ( _Oblig, "#,##0" ) & "</b></div>
                        <div><span>Promedio</span><b>" & FORMAT ( _Prom, "$ #,##0.00" ) & "</b></div>
                    </div>
                </div>",
            "",
            [__MontoEstado], DESC,
            'GEOREFERENCIACION'[EstadoEspecifico], ASC
        )
    )

/* ============================================================
   DESGLOSE POR ESTADO SELECCIONADO · TÍTULOS
   ============================================================ */
VAR _EstadosTitulosBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'GEOREFERENCIACION'[EstadoEspecifico] ),
                KEEPFILTERS ( _FiltroCartera ),
                KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
            ),
            "__MontoEstado",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
                ),
            "__ObligEstado",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdDeuda] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
                ),
            "__ContEstado",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    KEEPFILTERS ( 'GEOREFERENCIACION'[CodFaseDeuda] = "TIT" )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[EstadoEspecifico] )
            && TRIM ( 'GEOREFERENCIACION'[EstadoEspecifico] & "" ) <> ""
            && [__MontoEstado] > 0
    )

VAR _HtmlEstadosTitulos =
    IF (
        COUNTROWS ( _EstadosTitulosBase ) = 0,
        "<div class='phase-state-empty'>Sin cartera de Títulos para los estados seleccionados.</div>",
        CONCATENATEX (
            _EstadosTitulosBase,
            VAR _Estado = TRIM ( 'GEOREFERENCIACION'[EstadoEspecifico] & "" )
            VAR _Monto = [__MontoEstado]
            VAR _Oblig = [__ObligEstado]
            VAR _Cont = [__ContEstado]
            VAR _Pct = DIVIDE ( _Monto, _CarteraTitulosTotal, 0 )
            VAR _Prom = DIVIDE ( _Monto, _Cont, 0 )
            RETURN
                "<div class='phase-state-row'>
                    <div class='phase-state-main'>
                        <span class='phase-state-name'>" & _Estado & "</span>
                        <span class='phase-state-pct'>" & FORMAT ( _Pct, "0.0%" ) & "</span>
                    </div>
                    <div class='phase-state-metrics'>
                        <div><span>Cartera</span><b>" & FORMAT ( _Monto, "$ #,##0.00" ) & "</b></div>
                        <div><span>Contrib.</span><b>" & FORMAT ( _Cont, "#,##0" ) & "</b></div>
                        <div><span>Oblig.</span><b>" & FORMAT ( _Oblig, "#,##0" ) & "</b></div>
                        <div><span>Promedio</span><b>" & FORMAT ( _Prom, "$ #,##0.00" ) & "</b></div>
                    </div>
                </div>",
            "",
            [__MontoEstado], DESC,
            'GEOREFERENCIACION'[EstadoEspecifico], ASC
        )
    )

VAR _WCoactivaFase =
    SUBSTITUTE (
        FORMAT ( _PctCarteraCoactivaTotal * 100, "0.0" ),
        ",",
        "."
    )

VAR _WTitulosFase =
    SUBSTITUTE (
        FORMAT ( _PctCarteraTitulosTotal * 100, "0.0" ),
        ",",
        "."
    )

VAR _FaseMayorCartera =
    IF (
        _CarteraCoactivaTotal >= _CarteraTitulosTotal,
        "COACTIVA",
        "TÍTULOS"
    )

VAR _MontoFaseMayorCartera =
    MAX (
        _CarteraCoactivaTotal,
        _CarteraTitulosTotal
    )

VAR _PctFaseMayorCartera =
    MAX (
        _PctCarteraCoactivaTotal,
        _PctCarteraTitulosTotal
    )

VAR _BrechaCarteraFases =
    ABS (
        _CarteraCoactivaTotal
            - _CarteraTitulosTotal
    )

VAR _MensajeEjecutivoFases =
    _FaseMayorCartera &
    " concentra la mayor exposición con " &
    FORMAT ( _MontoFaseMayorCartera, "$ #,##0.00" ) &
    " (" &
    FORMAT ( _PctFaseMayorCartera, "0.0%" ) &
    " de la cartera). Operativamente, la deuda nace en Títulos y, si no se logra recuperar, migra a Coactiva. La diferencia entre ambas fases es " &
    FORMAT ( _BrechaCarteraFases, "$ #,##0.00" ) &
    "."

/* ============================================================ */

VAR _Criticos =
    COUNTROWS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "CRITICO" )
    )
VAR _Altos =
    COUNTROWS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "ALTO" )
    )
VAR _Medios =
    COUNTROWS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "MEDIO" )
    )
VAR _Bajos =
    _Contribuyentes - _Criticos - _Altos - _Medios

VAR _PctCriticos = DIVIDE ( _Criticos, _Contribuyentes, 0 )
VAR _PctAltos = DIVIDE ( _Altos, _Contribuyentes, 0 )
VAR _PctMedios = DIVIDE ( _Medios, _Contribuyentes, 0 )
VAR _PctBajos = DIVIDE ( _Bajos, _Contribuyentes, 0 )

/* MONTO DE CARTERA REPRESENTADO POR CADA SEGMENTO */
VAR _MontoCriticos =
    SUMX (
        FILTER ( _ContribuyentesBase, [__Segmento] = "CRITICO" ),
        [__Deuda]
    )
VAR _MontoAltos =
    SUMX (
        FILTER ( _ContribuyentesBase, [__Segmento] = "ALTO" ),
        [__Deuda]
    )
VAR _MontoMedios =
    SUMX (
        FILTER ( _ContribuyentesBase, [__Segmento] = "MEDIO" ),
        [__Deuda]
    )
VAR _MontoBajos =
    MAX ( 0, _Cartera - _MontoCriticos - _MontoAltos - _MontoMedios )

VAR _PctCarteraCriticos = DIVIDE ( _MontoCriticos, _Cartera, 0 )
VAR _PctCarteraAltos = DIVIDE ( _MontoAltos, _Cartera, 0 )
VAR _PctCarteraMedios = DIVIDE ( _MontoMedios, _Cartera, 0 )
VAR _PctCarteraBajos = DIVIDE ( _MontoBajos, _Cartera, 0 )


/* ============================================================
   UBICACIÓN TERRITORIAL DE LA SEGMENTACIÓN
   Objetivo: identificar en qué parroquias existe presencia de
   contribuyentes Críticos / Altos / Medios / Bajos.

   IMPORTANTE:
   - La tabla representa PRESENCIA TERRITORIAL.
   - Un contribuyente puede figurar en más de una parroquia si
     posee obligaciones asociadas a distintos territorios.
   - Por ello, los conteos por parroquia NO deben sumarse para
     reconciliarse contra el total único de cada segmento.
   ============================================================ */

VAR _IdsCriticos =
    SELECTCOLUMNS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "CRITICO" ),
        "__Id", 'GEOREFERENCIACION'[IdContribuyente]
    )
VAR _IdsAltos =
    SELECTCOLUMNS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "ALTO" ),
        "__Id", 'GEOREFERENCIACION'[IdContribuyente]
    )
VAR _IdsMedios =
    SELECTCOLUMNS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "MEDIO" ),
        "__Id", 'GEOREFERENCIACION'[IdContribuyente]
    )
VAR _IdsBajos =
    SELECTCOLUMNS (
        FILTER ( _ContribuyentesBase, [__Segmento] = "BAJO" ),
        "__Id", 'GEOREFERENCIACION'[IdContribuyente]
    )
VAR _SegmentacionParroquiaBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'GEOREFERENCIACION'[Parroquia] ),
                KEEPFILTERS ( _FiltroCartera )
            ),

            "__CriticosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__AltosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MediosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__BajosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoCriticosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoAltosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoMediosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoBajosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[Parroquia] )
            && TRIM ( 'GEOREFERENCIACION'[Parroquia] & "" ) <> ""
            && (
                [__CriticosParroquia]
                + [__AltosParroquia]
                + [__MediosParroquia]
                + [__BajosParroquia]
            ) > 0
    )
VAR _SegmentacionParroquia =
    ADDCOLUMNS (
        _SegmentacionParroquiaBase,
        "__Prioridad",
            [__CriticosParroquia] + [__AltosParroquia],
        "__Presencias",
            [__CriticosParroquia]
            + [__AltosParroquia]
            + [__MediosParroquia]
            + [__BajosParroquia],
        "__CarteraParroquia",
            COALESCE ( [__MontoCriticosParroquia], 0 )
            + COALESCE ( [__MontoAltosParroquia], 0 )
            + COALESCE ( [__MontoMediosParroquia], 0 )
            + COALESCE ( [__MontoBajosParroquia], 0 )
    )
VAR _CantidadParroquiasAnalizadas =
    COUNTROWS ( _SegmentacionParroquia )

VAR _ParroquiasConPrioridad =
    COUNTROWS (
        FILTER (
            _SegmentacionParroquia,
            [__Prioridad] > 0
        )
    )

VAR _ParroquiasConCriticos =
    COUNTROWS (
        FILTER (
            _SegmentacionParroquia,
            [__CriticosParroquia] > 0
        )
    )

VAR _TopParroquiaPrioridadTabla =
    TOPN (
        1,
        _SegmentacionParroquia,
        DIVIDE ( [__CarteraParroquia], [__Presencias], 0 ), DESC,
        [__CarteraParroquia], DESC,
        [__Presencias], ASC,
        'GEOREFERENCIACION'[Parroquia], ASC
    )

VAR _TopParroquiaPrioridadNombreRaw =
    CONCATENATEX (
        _TopParroquiaPrioridadTabla,
        'GEOREFERENCIACION'[Parroquia],
        ""
    )

VAR _TopParroquiaPrioridadNombre =
    IF (
        ISBLANK ( _TopParroquiaPrioridadNombreRaw )
            || TRIM ( _TopParroquiaPrioridadNombreRaw ) = "",
        "SIN DATO",
        _TopParroquiaPrioridadNombreRaw
    )

VAR _TopParroquiaPrioridadPromedio =
    MAXX (
        _TopParroquiaPrioridadTabla,
        DIVIDE ( [__CarteraParroquia], [__Presencias], 0 )
    )

VAR _TopParroquiaCarteraTabla =
    TOPN (
        1,
        _SegmentacionParroquia,
        [__CarteraParroquia], DESC,
        [__Prioridad], DESC,
        'GEOREFERENCIACION'[Parroquia], ASC
    )

VAR _TopParroquiaCarteraNombreRaw =
    CONCATENATEX (
        _TopParroquiaCarteraTabla,
        'GEOREFERENCIACION'[Parroquia],
        ""
    )

VAR _TopParroquiaCarteraNombre =
    IF (
        ISBLANK ( _TopParroquiaCarteraNombreRaw )
            || TRIM ( _TopParroquiaCarteraNombreRaw ) = "",
        "SIN DATO",
        _TopParroquiaCarteraNombreRaw
    )

VAR _TopParroquiaCarteraMonto =
    MAXX (
        _TopParroquiaCarteraTabla,
        [__CarteraParroquia]
    )

VAR _Top5ParroquiasTabla =
    TOPN (
        5,
        _SegmentacionParroquia,
        [__CarteraParroquia], DESC,
        [__Prioridad], DESC,
        'GEOREFERENCIACION'[Parroquia], ASC
    )

VAR _CarteraTop5Parroquias =
    SUMX (
        _Top5ParroquiasTabla,
        [__CarteraParroquia]
    )

VAR _CarteraConParroquiaInformada =
    SUMX (
        _SegmentacionParroquia,
        [__CarteraParroquia]
    )
VAR _PctCarteraTop5Parroquias =
    DIVIDE (
        _CarteraTop5Parroquias,
        _CarteraConParroquiaInformada,
        0
    )

VAR _MensajeEjecutivoParroquia =
    "Se identifican " &
    FORMAT ( _CantidadParroquiasAnalizadas, "#,##0" ) &
    " parroquias con cartera dentro del filtro actual; " &
    FORMAT ( _ParroquiasConPrioridad, "#,##0" ) &
    " presentan al menos un contribuyente Crítico o Alto y " &
    FORMAT ( _ParroquiasConCriticos, "#,##0" ) &
    " contienen presencia crítica. La parroquia con mayor prioridad territorial por rendimiento promedio es " &
    _TopParroquiaPrioridadNombre &
    " con " &
    FORMAT ( _TopParroquiaPrioridadPromedio, "$ #,##0.00" ) &
    " de cartera promedio por contribuyente. Las cinco parroquias de mayor cartera concentran " &
    FORMAT ( _PctCarteraTop5Parroquias, "0.0%" ) &
    " de la cartera con parroquia informada."

/* Orden ejecutivo:
   1. Mayor cartera territorial
   2. Menor cantidad de contribuyentes
   3. Mayor prioridad (Críticos + Altos)
   4. Parroquia alfabética
*/
VAR _HtmlSegmentacionParroquia =
    CONCATENATEX (
        _SegmentacionParroquia,
VAR _ParroquiaTexto = 'GEOREFERENCIACION'[Parroquia]

        VAR _Crit = [__CriticosParroquia]
        VAR _Alt  = [__AltosParroquia]
        VAR _Med  = [__MediosParroquia]
        VAR _Baj  = [__BajosParroquia]

        VAR _MontoCrit =
            COALESCE ( [__MontoCriticosParroquia], 0 )
        VAR _MontoAlt =
            COALESCE ( [__MontoAltosParroquia], 0 )
        VAR _MontoMed =
            COALESCE ( [__MontoMediosParroquia], 0 )
        VAR _MontoBaj =
            COALESCE ( [__MontoBajosParroquia], 0 )

        VAR _ClaseRiesgo =
            "seg-risk-row"
                & IF ( _Crit > 0, " has-critical", "" )
                & IF ( _Alt > 0, " has-high", "" )
                & IF ( _Med > 0, " has-medium", "" )
                & IF ( _Baj > 0, " has-low", "" )

        RETURN
            "<tr class='" & _ClaseRiesgo & "'>
                <td class='seg-parr-name'>" & _ParroquiaTexto & "</td>
                <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>
                <td class='seg-num total seg-dynamic'
                    data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                    data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                    data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                    data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                    data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                    data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                    data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                    data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                    data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                    data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                    data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                    data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                    data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                    data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                    data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>
                <td class='seg-money seg-dynamic'
                    data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( _MontoAlt, "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( _MontoMed, "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( _MontoBaj, "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( _MontoCrit + _MontoAlt, "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( _MontoCrit + _MontoMed, "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( _MontoCrit + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>
                <td class='seg-average seg-dynamic'
                    data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
            </tr>",

        "",
        DIVIDE ( [__CarteraParroquia], [__Presencias], 0 ), DESC,
        [__CarteraParroquia], DESC,
        [__Presencias], ASC,
        [__Prioridad], DESC,
        'GEOREFERENCIACION'[Parroquia], ASC
    )


VAR _SegmentacionSectorBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                VALUES ( 'GEOREFERENCIACION'[SectorNomenclatura] ),
                KEEPFILTERS ( _FiltroCartera )
            ),

            "__CriticosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__AltosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MediosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__BajosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoCriticosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoAltosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoMediosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoBajosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[SectorNomenclatura] )
            && TRIM ( 'GEOREFERENCIACION'[SectorNomenclatura] & "" ) <> ""
            && (
                [__CriticosSector]
                + [__AltosSector]
                + [__MediosSector]
                + [__BajosSector]
            ) > 0
    )
VAR _SegmentacionSector =
    ADDCOLUMNS (
        _SegmentacionSectorBase,
        "__PrioridadSector",
            [__CriticosSector] + [__AltosSector],
        "__PresenciasSector",
            [__CriticosSector]
            + [__AltosSector]
            + [__MediosSector]
            + [__BajosSector],
        "__CarteraSector",
            COALESCE ( [__MontoCriticosSector], 0 )
            + COALESCE ( [__MontoAltosSector], 0 )
            + COALESCE ( [__MontoMediosSector], 0 )
            + COALESCE ( [__MontoBajosSector], 0 )
    )
VAR _CantidadSectoresAnalizados =
    COUNTROWS ( _SegmentacionSector )

VAR _SectoresConPrioridad =
    COUNTROWS (
        FILTER (
            _SegmentacionSector,
            [__PrioridadSector] > 0
        )
    )

VAR _SectoresConCriticos =
    COUNTROWS (
        FILTER (
            _SegmentacionSector,
            [__CriticosSector] > 0
        )
    )

VAR _TopSectorPrioridadTabla =
    TOPN (
        1,
        _SegmentacionSector,
        DIVIDE ( [__CarteraSector], [__PresenciasSector], 0 ), DESC,
        [__CarteraSector], DESC,
        [__PresenciasSector], ASC,
        'GEOREFERENCIACION'[SectorNomenclatura], ASC
    )

VAR _TopSectorPrioridadNombreRaw =
    CONCATENATEX (
        _TopSectorPrioridadTabla,
        'GEOREFERENCIACION'[SectorNomenclatura],
        ""
    )

VAR _TopSectorPrioridadNombre =
    IF (
        ISBLANK ( _TopSectorPrioridadNombreRaw )
            || TRIM ( _TopSectorPrioridadNombreRaw ) = "",
        "SIN DATO",
        _TopSectorPrioridadNombreRaw
    )

VAR _TopSectorPrioridadPromedio =
    MAXX (
        _TopSectorPrioridadTabla,
        DIVIDE ( [__CarteraSector], [__PresenciasSector], 0 )
    )

VAR _TopSectorCarteraTabla =
    TOPN (
        1,
        _SegmentacionSector,
        [__CarteraSector], DESC,
        [__PrioridadSector], DESC,
        'GEOREFERENCIACION'[SectorNomenclatura], ASC
    )

VAR _TopSectorCarteraNombreRaw =
    CONCATENATEX (
        _TopSectorCarteraTabla,
        'GEOREFERENCIACION'[SectorNomenclatura],
        ""
    )

VAR _TopSectorCarteraNombre =
    IF (
        ISBLANK ( _TopSectorCarteraNombreRaw )
            || TRIM ( _TopSectorCarteraNombreRaw ) = "",
        "SIN DATO",
        _TopSectorCarteraNombreRaw
    )

VAR _TopSectorCarteraMonto =
    MAXX (
        _TopSectorCarteraTabla,
        [__CarteraSector]
    )

VAR _Top5SectoresTabla =
    TOPN (
        5,
        _SegmentacionSector,
        [__CarteraSector], DESC,
        [__PrioridadSector], DESC,
        'GEOREFERENCIACION'[SectorNomenclatura], ASC
    )

VAR _CarteraTop5Sectores =
    SUMX (
        _Top5SectoresTabla,
        [__CarteraSector]
    )

VAR _CarteraConSectorInformado =
    SUMX (
        _SegmentacionSector,
        [__CarteraSector]
    )
VAR _PctCarteraTop5Sectores =
    DIVIDE (
        _CarteraTop5Sectores,
        _CarteraConSectorInformado,
        0
    )

/* Orden ejecutivo:
   1. Mayor cartera territorial
   2. Menor cantidad de contribuyentes
   3. Mayor prioridad (Críticos + Altos)
   4. Sector alfabético
*/
VAR _HtmlSegmentacionSector =
    CONCATENATEX (
        _SegmentacionSector,

        VAR _SectorActual =
            'GEOREFERENCIACION'[SectorNomenclatura]

        VAR _Crit = [__CriticosSector]
        VAR _Alt  = [__AltosSector]
        VAR _Med  = [__MediosSector]
        VAR _Baj  = [__BajosSector]

        VAR _MontoCrit =
            COALESCE ( [__MontoCriticosSector], 0 )
        VAR _MontoAlt =
            COALESCE ( [__MontoAltosSector], 0 )
        VAR _MontoMed =
            COALESCE ( [__MontoMediosSector], 0 )
        VAR _MontoBaj =
            COALESCE ( [__MontoBajosSector], 0 )

        VAR _ClaseRiesgo =
            "seg-risk-row"
                & IF ( _Crit > 0, " has-critical", "" )
                & IF ( _Alt > 0, " has-high", "" )
                & IF ( _Med > 0, " has-medium", "" )
                & IF ( _Baj > 0, " has-low", "" )

        RETURN
            "<tr class='" & _ClaseRiesgo & "'>
                <td class='seg-parr-name'>" & _SectorActual & "</td>
                <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>
                <td class='seg-num total seg-dynamic'
                    data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                    data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                    data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                    data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                    data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                    data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                    data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                    data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                    data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                    data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                    data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                    data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                    data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                    data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                    data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>
                <td class='seg-money seg-dynamic'
                    data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( _MontoAlt, "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( _MontoMed, "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( _MontoBaj, "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( _MontoCrit + _MontoAlt, "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( _MontoCrit + _MontoMed, "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( _MontoCrit + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>
                <td class='seg-average seg-dynamic'
                    data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed + _MontoBaj, _Crit + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed + _MontoBaj, _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, _Crit + _Alt + _Med + _Baj, 0 ), "$ #,##0.00" ) & "'></td>
            </tr>",

        "",
        DIVIDE ( [__CarteraSector], [__PresenciasSector], 0 ), DESC,
        [__CarteraSector], DESC,
        [__PresenciasSector], ASC,
        [__PrioridadSector], DESC,
        'GEOREFERENCIACION'[SectorNomenclatura], ASC
    )


VAR _MensajeEjecutivoSector =
    "Se identifican " &
    FORMAT ( _CantidadSectoresAnalizados, "#,##0" ) &
    " sectores con cartera dentro del filtro actual; " &
    FORMAT ( _SectoresConPrioridad, "#,##0" ) &
    " presentan al menos un contribuyente Crítico o Alto y " &
    FORMAT ( _SectoresConCriticos, "#,##0" ) &
    " contienen presencia crítica. El sector con mayor prioridad territorial por rendimiento promedio es " &
    _TopSectorPrioridadNombre &
    " con " &
    FORMAT ( _TopSectorPrioridadPromedio, "$ #,##0.00" ) &
    " de cartera promedio por contribuyente. Los cinco sectores de mayor cartera concentran " &
    FORMAT ( _PctCarteraTop5Sectores, "0.0%" ) &
    " de la cartera con sector informado."


/* ============================================================
   VISTAS INTERNAS POR FASE · OPTIMIZACIÓN HÍBRIDA

   OBJETIVO:
   Recuperar los botones GENERAL / TÍTULOS / COACTIVA dentro del
   mismo HTML sin volver a duplicar todo el dashboard.

   CRITERIO DE RENDIMIENTO:
   - GENERAL conserva la segmentación consolidada ya calculada.
   - TÍTULOS y COACTIVA reutilizan los mismos IdContribuyente por
     segmento y solo recalculan la distribución territorial de la
     cartera por fase.
   - No se recalculan KPIs, notificación, rubros ni demás secciones
     por cada fase.
   ============================================================ */

VAR _SegmentacionParroquiaFaseBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                SUMMARIZECOLUMNS (
                    'GEOREFERENCIACION'[Parroquia],
                    'GEOREFERENCIACION'[CodFaseDeuda]
                ),
                KEEPFILTERS ( _FiltroCartera )
            ),

            "__CriticosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__AltosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MediosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__BajosParroquia",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoCriticosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoAltosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoMediosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoBajosParroquia",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[Parroquia] )
            && TRIM ( 'GEOREFERENCIACION'[Parroquia] & "" ) <> ""
            && 'GEOREFERENCIACION'[CodFaseDeuda] IN { "TIT", "COA" }
            && (
                [__CriticosParroquia]
                + [__AltosParroquia]
                + [__MediosParroquia]
                + [__BajosParroquia]
            ) > 0
    )

VAR _SegmentacionParroquiaFase =
    ADDCOLUMNS (
        _SegmentacionParroquiaFaseBase,
        "__Prioridad",
            [__CriticosParroquia] + [__AltosParroquia],
        "__Presencias",
            [__CriticosParroquia]
            + [__AltosParroquia]
            + [__MediosParroquia]
            + [__BajosParroquia],
        "__CarteraParroquia",
            COALESCE ( [__MontoCriticosParroquia], 0 )
            + COALESCE ( [__MontoAltosParroquia], 0 )
            + COALESCE ( [__MontoMediosParroquia], 0 )
            + COALESCE ( [__MontoBajosParroquia], 0 )
    )

VAR _SegmentacionParroquia_TIT =
    FILTER (
        _SegmentacionParroquiaFase,
        'GEOREFERENCIACION'[CodFaseDeuda] = "TIT"
    )

VAR _SegmentacionParroquia_COA =
    FILTER (
        _SegmentacionParroquiaFase,
        'GEOREFERENCIACION'[CodFaseDeuda] = "COA"
    )

VAR _CantidadParroquiasAnalizadas_TIT = COUNTROWS ( _SegmentacionParroquia_TIT )
VAR _CantidadParroquiasAnalizadas_COA = COUNTROWS ( _SegmentacionParroquia_COA )

VAR _HtmlSegmentacionParroquia_TIT =
    CONCATENATEX (
        _SegmentacionParroquia_TIT,
VAR _ParroquiaTexto = 'GEOREFERENCIACION'[Parroquia]

        VAR _Crit = [__CriticosParroquia]
        VAR _Alt  = [__AltosParroquia]
        VAR _Med  = [__MediosParroquia]
        VAR _Baj  = [__BajosParroquia]

        VAR _MontoCrit =
            COALESCE ( [__MontoCriticosParroquia], 0 )
        VAR _MontoAlt =
            COALESCE ( [__MontoAltosParroquia], 0 )
        VAR _MontoMed =
            COALESCE ( [__MontoMediosParroquia], 0 )
        VAR _MontoBaj =
            COALESCE ( [__MontoBajosParroquia], 0 )

        VAR _ClaseRiesgo =
            "seg-risk-row"
                & IF ( _Crit > 0, " has-critical", "" )
                & IF ( _Alt > 0, " has-high", "" )
                & IF ( _Med > 0, " has-medium", "" )
                & IF ( _Baj > 0, " has-low", "" )

        RETURN
            "<tr class='" & _ClaseRiesgo & "'>
                <td class='seg-parr-name'>" & _ParroquiaTexto & "</td>
                <td class='seg-num critical'>" & FORMAT ( _Crit, "#,##0" ) & "</td>
                <td class='seg-num high'>" & FORMAT ( _Alt, "#,##0" ) & "</td>
                <td class='seg-num medium'>" & FORMAT ( _Med, "#,##0" ) & "</td>
                <td class='seg-num low'>" & FORMAT ( _Baj, "#,##0" ) & "</td>
                <td class='seg-num total seg-dynamic'
                    data-c='" & FORMAT ( _Crit, "#,##0" ) & "'
                    data-h='" & FORMAT ( _Alt, "#,##0" ) & "'
                    data-m='" & FORMAT ( _Med, "#,##0" ) & "'
                    data-l='" & FORMAT ( _Baj, "#,##0" ) & "'
                    data-ch='" & FORMAT ( _Crit + _Alt, "#,##0" ) & "'
                    data-cm='" & FORMAT ( _Crit + _Med, "#,##0" ) & "'
                    data-cl='" & FORMAT ( _Crit + _Baj, "#,##0" ) & "'
                    data-hm='" & FORMAT ( _Alt + _Med, "#,##0" ) & "'
                    data-hl='" & FORMAT ( _Alt + _Baj, "#,##0" ) & "'
                    data-ml='" & FORMAT ( _Med + _Baj, "#,##0" ) & "'
                    data-chm='" & FORMAT ( _Crit + _Alt + _Med, "#,##0" ) & "'
                    data-chl='" & FORMAT ( _Crit + _Alt + _Baj, "#,##0" ) & "'
                    data-cml='" & FORMAT ( _Crit + _Med + _Baj, "#,##0" ) & "'
                    data-hml='" & FORMAT ( _Alt + _Med + _Baj, "#,##0" ) & "'
                    data-all='" & FORMAT ( _Crit + _Alt + _Med + _Baj, "#,##0" ) & "'></td>
                <td class='seg-money seg-dynamic'
                    data-c='" & FORMAT ( _MontoCrit, "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( _MontoAlt, "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( _MontoMed, "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( _MontoBaj, "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( _MontoCrit + _MontoAlt, "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( _MontoCrit + _MontoMed, "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( _MontoCrit + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed, "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoBaj, "$ #,##0.00" ) & "'
                    data-cml='" & FORMAT ( _MontoCrit + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-hml='" & FORMAT ( _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'
                    data-all='" & FORMAT ( _MontoCrit + _MontoAlt + _MontoMed + _MontoBaj, "$ #,##0.00" ) & "'></td>
                <td class='seg-average seg-dynamic'
                    data-c='" & FORMAT ( DIVIDE ( _MontoCrit, _Crit, 0 ), "$ #,##0.00" ) & "'
                    data-h='" & FORMAT ( DIVIDE ( _MontoAlt, _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-m='" & FORMAT ( DIVIDE ( _MontoMed, _Med, 0 ), "$ #,##0.00" ) & "'
                    data-l='" & FORMAT ( DIVIDE ( _MontoBaj, _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ch='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt, _Crit + _Alt, 0 ), "$ #,##0.00" ) & "'
                    data-cm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoMed, _Crit + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-ml='" & FORMAT ( DIVIDE ( _MontoMed + _MontoBaj, _Med + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-chm='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoMed, _Crit + _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-chl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoAlt + _MontoBaj, _Crit + _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
