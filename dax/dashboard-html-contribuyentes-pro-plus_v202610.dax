}
.geo-unified-decision .stats{
 text-align:right;
 font-size:9.5px;
 color:#5b6670;
 line-height:1.5
}
.geo-unified-decision .stats b{
 color:#241460;
 font-size:12px
}

.nogeo-rubros{
 background:white;
 border:1px solid #dfe8ed;
 border-radius:12px;
 padding:14px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(0,0,0,.05)
}
.nogeo-rubros-head{
 display:flex;
 justify-content:space-between;
 align-items:flex-start;
 gap:16px;
 margin-bottom:10px
}
.nogeo-rubros-head h3{
 margin:0;
 color:#241460;
 font-size:16px;
 font-weight:800
}
.nogeo-rubros-head p{
 margin:4px 0 0;
 color:#737f88;
 font-size:9.5px;
 line-height:1.4
}
.nogeo-rubros-summary{
 text-align:right;
 white-space:nowrap;
 font-size:9px;
 color:#6a7580
}
.nogeo-rubros-summary b{
 display:block;
 font-size:17px;
 color:#CC4534;
 margin-bottom:2px
}
.nogeo-table-wrap{
 max-height:360px;
 overflow:auto;
 border:1px solid #e4ebef;
 border-radius:9px
}
.nogeo-table{
 width:100%;
 border-collapse:collapse;
 table-layout:fixed
}
.nogeo-table th{
 position:sticky;
 top:0;
 z-index:2;
 background:#241460;
 color:white;
 font-size:8.5px;
 font-weight:800;
 text-transform:uppercase;
 padding:8px 7px;
 border-bottom:3px solid #0FACF1
}
.nogeo-table td{
 font-size:9.5px;
 padding:8px 7px;
 border-bottom:1px solid #e9edf1;
 color:#34434d
}
.nogeo-table tbody tr:nth-child(even){background:#fafbfe}
.nogeo-table tbody tr:hover{background:#eef8ff}
.nogeo-rubro{
 font-weight:700;
 color:#241460!important;
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis
}
.nogeo-note{
 margin-top:9px;
 font-size:9px;
 line-height:1.45;
 color:#58656e;
 background:#fff8e8;
 border-left:4px solid #FAD30A;
 border-radius:7px;
 padding:8px 10px
}

.geo-decision{
 background:white;
 border:1px solid #dfe8ed;
 border-radius:12px;
 padding:14px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(0,0,0,.05)
}
.geo-exec-head{
 display:flex;
 justify-content:space-between;
 align-items:flex-start;
 gap:18px;
 margin-bottom:12px
}
.geo-exec-head h3{margin:0;color:#241460;font-size:18px;font-weight:800}
.geo-exec-head p{margin:4px 0 0;color:#7d8790;font-size:10px;line-height:1.45}
.geo-exec-badge{
 font-size:8.5px;
 font-weight:800;
 color:#075878;
 background:#eaf8fd;
 border:1px solid #b9e3f2;
 border-radius:12px;
 padding:5px 9px;
 white-space:nowrap
}
.geo-decision-banner{
 background:linear-gradient(95deg,#241460 0%,#2A3082 62%,#0FACF1 100%);
 color:white;
 border-radius:10px;
 padding:12px 14px;
 margin-bottom:11px;
 display:grid;
 grid-template-columns:1.4fr .6fr;
 gap:18px;
 align-items:center
}
.geo-decision-banner .eyebrow{
 font-size:8px;
 text-transform:uppercase;
 font-weight:800;
 letter-spacing:.45px;
 opacity:.78
}
.geo-decision-banner .main{
 font-size:15px;
 font-weight:800;
 margin-top:4px;
 line-height:1.3
}
.geo-decision-banner .sub{
 font-size:9.8px;
 margin-top:5px;
 line-height:1.4;
 opacity:.88
}
.geo-decision-banner .metric{
 text-align:right;
 border-left:1px solid rgba(255,255,255,.25);
 padding-left:16px
}
.geo-decision-banner .metric b{
 display:block;
 font-size:24px;
 line-height:1
}
.geo-decision-banner .metric span{
 display:block;
 font-size:8.5px;
 margin-top:5px;
 opacity:.82
}
.geo-exec-kpis{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:8px;
 margin-bottom:11px
}
.geo-exec-kpi{
 background:#f8fafb;
 border:1px solid #e6edf1;
 border-radius:9px;
 padding:10px;
 min-width:0
}
.geo-exec-kpi.ready{border-top:4px solid #24694F}
.geo-exec-kpi.fix{border-top:4px solid #FAD30A}
.geo-exec-kpi.critical{border-top:4px solid #CC4534}
.geo-exec-kpi.cover{border-top:4px solid #0FACF1}
.geo-exec-kpi .lbl{
 display:block;
 font-size:8px;
 font-weight:800;
 color:#7a8790;
 text-transform:uppercase;
 letter-spacing:.25px
}
.geo-exec-kpi b{
 display:block;
 font-size:18px;
 color:#241460;
 margin-top:4px
}
.geo-exec-kpi span{
 display:block;
 font-size:8.5px;
 color:#87939b;
 margin-top:3px;
 line-height:1.3
}
.geo-actions{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:9px;
 margin-bottom:10px
}
.geo-action-card{
 border-radius:10px;
 padding:11px;
 border:1px solid #e6ebf0;
 background:#fbfcfd;
 min-height:120px
}
.geo-action-card .prio{
 display:inline-block;
 font-size:7.8px;
 font-weight:800;
 border-radius:10px;
 padding:4px 7px;
 margin-bottom:7px
}
.geo-action-card h4{
 margin:0 0 5px;
 font-size:12px;
 color:#241460
}
.geo-action-card p{
 margin:0;
 font-size:9.2px;
 color:#596772;
 line-height:1.45
}
.geo-action-card .foot{
 margin-top:8px;
 padding-top:7px;
 border-top:1px solid #e8edf1;
 font-size:8.5px;
 font-weight:750;
 color:#4e5962
}
.geo-action-card.ready .prio{background:#e9f5ef;color:#24694F}
.geo-action-card.fix .prio{background:#fff7ce;color:#7a6200}
.geo-action-card.critical .prio{background:#fdeceb;color:#a4382c}
.geo-bottom{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:9px
}
.geo-bottom-card{
 background:#f8fafb;
 border:1px solid #e7edf1;
 border-radius:9px;
 padding:10px
}
.geo-bottom-card h4{
 margin:0 0 7px;
 font-size:10.8px;
 color:#241460
}
.geo-minirow{
 display:grid;
 grid-template-columns:1fr auto;
 gap:10px;
 padding:7px 0;
 border-bottom:1px solid #e9eef1;
 font-size:9px
}
.geo-minirow:last-child{border-bottom:none}
.geo-minirow b{color:#241460;text-align:right}
.geo-exec-note{
 background:#eef8ff;
 border-left:4px solid #0FACF1;
 border-radius:8px;
 padding:10px 12px;
 font-size:9.5px;
 line-height:1.45;
 color:#344b5a
}
.geo-exec-note b{color:#241460}
.geo-alert{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:18px;
 background:linear-gradient(90deg,#fff8e8,#fffdf8);
 border:1px solid #ead7aa;
 border-left:5px solid #c99a36;
 border-radius:11px;
 padding:11px 14px;
 margin-bottom:10px;
 box-shadow:0 2px 8px rgba(0,0,0,.04)
}
.geo-alert-label{
 font-size:8.5px;
 font-weight:800;
 color:#9a7425;
 text-transform:uppercase;
 letter-spacing:.45px;
 margin-bottom:2px
}
.geo-alert-title{font-size:12px;font-weight:720;color:#123f5c}
.geo-alert-metric{text-align:right;white-space:nowrap}
.geo-alert-metric b{display:block;font-size:20px;color:#9a5f16}
.geo-alert-metric span{display:block;font-size:9.5px;color:#7e8b94;margin-top:2px}
.geo-detail{
 background:white;
 border:1px solid #dfe8ed;
 border-radius:12px;
 padding:14px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(0,0,0,.05)
}
.geo-detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:10px}
.geo-detail-head h3{margin:0;color:#123f5c;font-size:16px}
.geo-detail-head p{margin:3px 0 0;color:#7f8c95;font-size:9.5px;line-height:1.4}
.geo-criterion{font-size:8px;font-weight:750;color:#8b6720;background:#fff7e3;border:1px solid #ead8aa;border-radius:12px;padding:5px 8px;white-space:nowrap}
.geo-kpis{display:grid;grid-template-columns:1.35fr 1fr 1fr .8fr .8fr;gap:7px;margin-bottom:10px}
.geo-mini{background:#f7fafb;border:1px solid #e5ecef;border-radius:9px;padding:9px;min-width:0}
.geo-mini.total{background:#fff8e8;border-color:#ead7aa}
.geo-mini.coa{border-top:3px solid #126d8b}
.geo-mini.tit{border-top:3px solid #c99a36}
.geo-mini .lbl{font-size:8px;text-transform:uppercase;font-weight:780;color:#7c8992;letter-spacing:.3px}
.geo-mini b{display:block;font-size:15px;color:#123f5c;margin-top:3px;white-space:nowrap}
.geo-mini.total b{color:#9a5f16;font-size:18px}
.geo-mini span{display:block;font-size:8.2px;color:#88949c;margin-top:2px}
.geo-analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.geo-subcard{background:#f8fafb;border:1px solid #e8eef1;border-radius:9px;padding:10px}
.geo-subtitle{font-size:11px;font-weight:760;color:#123f5c;margin-bottom:7px}
.geo-phase-row{display:grid;grid-template-columns:85px 1fr 110px;gap:8px;align-items:center;margin:8px 0;font-size:9.5px}
.geo-phase-track{height:12px;background:#e8edf1;border-radius:8px;overflow:hidden}
.geo-phase-fill-coa{height:100%;background:#126d8b;border-radius:8px}
.geo-phase-fill-tit{height:100%;background:#c99a36;border-radius:8px}
.geo-phase-row b{text-align:right;color:#123f5c}
.geo-quality-row{display:grid;grid-template-columns:1fr auto;gap:10px;padding:8px 0;border-bottom:1px solid #e8eef1;font-size:9.5px}
.geo-quality-row:last-child{border-bottom:none}
.geo-quality-row b{text-align:right;color:#123f5c}
.geo-quality-row span small{display:block;color:#8a969e;margin-top:2px;font-size:8px}
.geo-detail-grid{display:grid;grid-template-columns:1.35fr .85fr;gap:10px;margin-bottom:10px}
.geo-table-wrap{overflow:hidden;border:1px solid #e4ebef;border-radius:9px;background:white}
.geo-table-wrap table{table-layout:fixed}
.geo-table-wrap th{font-size:8px;padding:6px;background:#174660}
.geo-table-wrap td{font-size:9px;padding:6px}
.geo-rubro{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#123f5c;font-weight:620}
.geo-diagnosis{background:linear-gradient(90deg,#eef6f8,#f8fbfc);border-left:4px solid #126d8b;border-radius:8px;padding:10px 12px;font-size:10px;line-height:1.5;color:#344b5a}
.geo-diagnosis b{color:#123f5c}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:10px}
.card{
 background:white;
 border-radius:12px;
 padding:14px;
 box-shadow:0 2px 9px rgba(0,0,0,.055)
}
.card-title{font-size:15px;font-weight:760;color:#123f5c;margin-bottom:10px}
.card-sub{font-size:10px;color:#87939c;margin-top:-6px;margin-bottom:10px}
.profile-wrap{display:grid;grid-template-columns:150px 1fr;gap:14px;align-items:center}
.donut:after{
 content:'';position:absolute;inset:23px;background:white;border-radius:50%;
 box-shadow:inset 0 0 0 1px #edf1f3
}
.donut-center{
 position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
 flex-direction:column;z-index:2
}
.donut-center b{font-size:19px;color:#123f5c}
.donut-center span{font-size:8px;color:#7c8992}
.legend-row{
 display:grid;grid-template-columns:10px 1fr auto;gap:7px;align-items:center;
 padding:7px 0;border-bottom:1px solid #eef2f4;font-size:9px
}
.dot{width:8px;height:8px;border-radius:50%}
.dot.teal{background:#126d8b}.dot.gold{background:#c99a36}.dot.green{background:#2d8b73}
.legend-row b{color:#123f5c}
.conc-row{
 display:grid;grid-template-columns:70px 1fr 55px;gap:8px;align-items:center;
 margin:9px 0;font-size:8.5px
}
.track{height:12px;background:#e8edf1;border-radius:8px;overflow:hidden}
.conc-fill{height:100%;background:linear-gradient(90deg,#123f5c,#15829a);border-radius:8px}
.hbar{
 display:grid;grid-template-columns:105px 1fr 60px;gap:8px;align-items:center;
 margin:7px 0;font-size:8.5px
}
.hbar b{text-align:right}
.fill-teal{height:100%;background:#126d8b;border-radius:8px}
.fill-gold{height:100%;background:#c99a36;border-radius:8px}
.fill-blue{height:100%;background:#547690;border-radius:8px}
.fill-purple{height:100%;background:#6f74aa;border-radius:8px}
.toprow{
 display:grid;grid-template-columns:180px 1fr 88px;gap:8px;align-items:center;margin:8px 0
}
.topname{font-size:8.4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.toptrack{height:13px;background:#e8edf1;border-radius:8px;overflow:hidden}
.topfill{height:100%;background:linear-gradient(90deg,#0d6886,#27a0b3);border-radius:8px}
.rubfill{height:100%;background:linear-gradient(90deg,#92714a,#c49a66);border-radius:8px}
.topvalue{text-align:right;font-size:8px}
.topvalue b{display:block;color:#123f5c}
.topvalue span{color:#84919a}
.insight{
 background:linear-gradient(90deg,#eef6f8,#f6f9fb);
 border-left:4px solid #126d8b;border-radius:8px;padding:11px 12px;
 font-size:9px;line-height:1.5;margin-bottom:10px
}
.risk-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.risk-box{border-radius:9px;padding:11px;text-align:center}
.risk-box b{display:block;font-size:18px}
.risk-box span{font-size:8px}
.risk-box.critical{background:#f9e8e8;color:#9e3434}
.risk-box.high{background:#fff1dc;color:#a56516}
.risk-box.medium{background:#fff8dd;color:#92731c}
.risk-box.low{background:#e9f5ef;color:#31785e}
.geo-line{
 display:flex;justify-content:space-between;border-bottom:1px solid #edf1f3;
 padding:6px 2px;font-size:8.5px;gap:10px
}
.geo-line span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.geo-line b{white-space:nowrap;color:#123f5c}
table{width:100%;border-collapse:collapse}
th{
 background:#123f5c;color:white;font-size:7.5px;padding:7px;text-transform:uppercase;text-align:left
}
td{font-size:9.5px;padding:7px;border-bottom:1px solid #e7ecef}
tbody tr:nth-child(even){background:#f9fafb}
.contrib{max-width:280px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:650;color:#123f5c}
.center{text-align:center}.num{text-align:right}.money{text-align:right}.strong{font-weight:750}
.risk{display:inline-block;padding:3px 6px;border-radius:12px;font-size:7px;font-weight:750}
.risk.critical{background:#f9e8e8;color:#9e3434}
.risk.high{background:#fff1dc;color:#a56516}
.risk.medium{background:#fff8dd;color:#92731c}
.risk.low{background:#e9f5ef;color:#31785e}
.selected{
 background:linear-gradient(135deg,#f7fafb,#eef5f7);
 border:1px solid #dbe5e9;border-radius:11px;padding:13px;margin-bottom:10px
}
.selected-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}
.selected-name{font-size:15px;font-weight:760;color:#123f5c}
.selected-id{font-size:8px;color:#7a8791;margin-top:2px}
.selected-kpis{display:flex;gap:14px;font-size:8px;color:#6e7b84}
.selected-kpis b{display:block;font-size:13px;color:#123f5c}
.footer{text-align:center;font-size:8px;color:#84919a;padding:6px 0 2px}

/* ============================================================
   ESCALA VISUAL AMPLIADA · MAYOR LEGIBILIDAD
   Mantiene estructura, lógica DAX, colores y distribución.
   ============================================================ */

/* Cabecera */
.hero{padding:22px 26px;margin-bottom:13px}
.hero h1{font-size:28px;line-height:1.15;margin-bottom:7px}
.hero p{font-size:12.5px;line-height:1.4}
.hero-badge{font-size:11px;padding:11px 14px}

/* Filtros */
.filters{gap:8px;margin-bottom:13px}
.filter{padding:10px 11px}
.filter label{font-size:8.5px;margin-bottom:5px}
.filter div{font-size:10.5px}

/* KPIs principales */
.kpis{gap:9px;margin-bottom:13px}
.kpi{padding:14px 12px;min-height:76px}
.kpi-label{font-size:8.5px;line-height:1.2}
.kpi-value{font-size:20px;line-height:1.2;margin-top:7px}

/* Alerta territorial */
.geo-alert{padding:14px 17px;margin-bottom:13px}
.geo-alert-label{font-size:8.5px;margin-bottom:4px}
.geo-alert-title{font-size:12.5px;line-height:1.3}
.geo-alert-metric b{font-size:21px}
.geo-alert-metric span{font-size:10px}

/* Detalle de georreferenciación */
.geo-detail{padding:17px;margin-bottom:13px}
.geo-detail-head{margin-bottom:13px}
.geo-detail-head h3{font-size:16px}
.geo-detail-head p{font-size:10px;line-height:1.5}
.geo-criterion{font-size:9px;padding:6px 10px}
.geo-kpis{gap:9px;margin-bottom:13px}
.geo-mini{padding:12px 10px}
.geo-mini .lbl{font-size:8px;line-height:1.2}
.geo-mini b{font-size:15px;margin-top:5px}
.geo-mini.total b{font-size:19px}
.geo-mini span{font-size:9px;margin-top:3px}
.geo-analysis-grid{gap:12px;margin-bottom:13px}
.geo-subcard{padding:13px}
.geo-subtitle{font-size:11px;margin-bottom:9px}
.geo-phase-row{grid-template-columns:82px 1fr 108px;gap:9px;margin:10px 0;font-size:10px}
.geo-phase-track{height:14px}
.geo-quality-row{padding:9px 0;font-size:10px}
.geo-quality-row span small{font-size:8.5px;margin-top:3px}
.geo-detail-grid{gap:12px;margin-bottom:13px}
.geo-table-wrap th{font-size:8.2px;padding:8px 7px}
.geo-table-wrap td{font-size:9.4px;padding:8px 7px}
.geo-diagnosis{padding:13px 15px;font-size:10.5px;line-height:1.6}

/* Tarjetas generales */
.grid2,.grid3{gap:12px;margin-bottom:13px}
.card{padding:17px}
.card-title{font-size:15px;margin-bottom:12px}
.card-sub{font-size:10px;line-height:1.4;margin-top:-5px;margin-bottom:12px}

/* Gráficos y leyendas */
.profile-wrap{grid-template-columns:165px 1fr;gap:17px}
.donut{width:145px;height:145px}
.donut:after{inset:26px}
.donut-center b{font-size:22px}
.donut-center span{font-size:10px}
.legend-row{grid-template-columns:11px 1fr auto;gap:8px;padding:9px 0;font-size:10.5px}
.dot{width:9px;height:9px}

.conc-row{grid-template-columns:78px 1fr 64px;gap:9px;margin:11px 0;font-size:10px}
.track{height:14px}

.hbar{grid-template-columns:122px 1fr 72px;gap:9px;margin:9px 0;font-size:10px}

.toprow{grid-template-columns:205px 1fr 105px;gap:9px;margin:10px 0}
.topname{font-size:10px}
.toptrack{height:15px}
.topvalue{font-size:9.5px;line-height:1.3}

.insight{padding:14px 15px;font-size:11px;line-height:1.6;margin-bottom:13px}

/* Segmentación operativa */
.risk-grid{gap:9px}
.risk-box{padding:14px}
.risk-box b{font-size:22px}
.risk-box span{font-size:10px}
.risk-box .risk-amount{
 display:block;
 margin-top:7px;
 font-size:13px;
 font-weight:800;
 line-height:1.2
}
.risk-box .risk-share{
 display:block;
 margin-top:3px;
 font-size:9px;
 font-weight:650;
 opacity:.82
}

/* Líneas geográficas */
.geo-line{padding:8px 3px;font-size:10px}

/* Tablas */
th{font-size:8.8px;padding:9px 8px}
td{font-size:9.5px;padding:9px 8px}
.risk{font-size:8.5px;padding:4px 7px}

/* Contribuyente seleccionado */
.selected{padding:16px;margin-bottom:13px}
.selected-name{font-size:18px}
.selected-id{font-size:10px;margin-top:4px}
.selected-kpis{gap:18px;font-size:10px}
.selected-kpis b{font-size:16px}

/* Pie */
.footer{font-size:9.5px;line-height:1.45;padding:8px 0 3px}


/* ============================================================
   IDENTIDAD VISUAL MUNICIPAL · GUAYAQUIL
   Paleta tomada del banner institucional adjunto:
   Morado institucional  #241460
   Azul institucional    #2A3082
   Celeste municipal     #0FACF1
   Celeste claro         #5FC0EE
   Amarillo institucional#FAD30A
   Verde escudo          #24694F
   Rojo escudo           #CC4534

   Tipografía:
   Montserrat como primera opción, con Century Gothic / Aptos /
   Segoe UI / Arial como respaldo para Power BI.
   ============================================================ */

.dashboard{
  font-family:'Montserrat','Century Gothic','Aptos','Segoe UI',Arial,sans-serif;
  background:#f7f9fd;
  color:#241460;
}

/* Franja institucional superior del dashboard */
.dashboard:before{
  content:'';
  display:block;
  height:5px;
  margin:-14px -14px 13px -14px;
  background:linear-gradient(
    90deg,
    #0FACF1 0%,
    #0FACF1 38%,
    #241460 38%,
    #241460 76%,
    #FAD30A 76%,
    #FAD30A 100%
  );
}

/* CABECERA */
.hero{
  position:relative;
  overflow:hidden;
  background:linear-gradient(118deg,#241460 0%,#2A3082 58%,#0A7DC0 100%);
  border-radius:16px;
  box-shadow:0 6px 18px rgba(36,20,96,.18);
}
.hero:after{
  content:'';
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  height:5px;
  background:linear-gradient(
    90deg,
    #0FACF1 0%,
    #0FACF1 38%,
    #241460 38%,
    #241460 76%,
    #FAD30A 76%,
    #FAD30A 100%
  );
}
.hero h1{
  font-family:'Montserrat','Century Gothic','Aptos','Segoe UI',Arial,sans-serif;
  font-weight:800;
  letter-spacing:-.35px;
}
.hero p{font-weight:500}
.hero-badge{
  background:rgba(15,172,241,.17);
  border:1px solid rgba(95,192,238,.55);
  color:#fff;
  font-weight:700;
}

/* FILTROS */
.filter{
  border:1px solid #dce3f5;
  box-shadow:0 1px 3px rgba(36,20,96,.035);
}
.filter label{
  color:#2A3082;
  font-weight:800;
}
.filter div{
  color:#241460;
  font-weight:700;
}

/* KPIs */
.kpi{
  border-top-color:#0FACF1;
  box-shadow:0 3px 10px rgba(36,20,96,.06);
}
.kpi:nth-child(1){border-top-color:#0FACF1}
.kpi:nth-child(2){border-top-color:#FAD30A}
.kpi:nth-child(3){border-top-color:#24694F}
.kpi:nth-child(4){border-top-color:#2A3082}
.kpi:nth-child(5){border-top-color:#CC4534}
.kpi:nth-child(6){border-top-color:#5FC0EE}
.kpi:nth-child(7){border-top-color:#FAD30A}
.kpi-label{
  color:#2A3082;
  font-weight:800;
}
.kpi-value{
  color:#241460;
  font-weight:800;
}

/* ALERTA / BRECHA TERRITORIAL */
.geo-alert{
  background:linear-gradient(90deg,#fff9dc,#fffdf3);
  border-color:#f0dd78;
  border-left-color:#FAD30A;
}
.geo-alert-label{color:#7a5d00}
.geo-alert-title{color:#241460}
.geo-alert-metric b{color:#241460}
.geo-alert-metric span{color:#625c79}

/* BLOQUE DE DETALLE TERRITORIAL */
.geo-detail{
  border-color:#dfe5f4;
  box-shadow:0 3px 10px rgba(36,20,96,.05);
}
.geo-detail-head h3,
.geo-subtitle,
.geo-phase-row b,
.geo-quality-row b,
.geo-mini b,
.geo-rubro,
.geo-diagnosis b{
  color:#241460;
}
.geo-detail-head p,
.geo-mini span,
.geo-quality-row span small{
  color:#6f6a80;
}
.geo-criterion{
  color:#5d4700;
  background:#fff9db;
  border-color:#f0dd78;
}
.geo-mini.total{
  background:#fff9dd;
  border-color:#f0dd78;
}
.geo-mini.total b{color:#241460}
.geo-mini.coa{border-top-color:#0FACF1}
.geo-mini.tit{border-top-color:#FAD30A}
.geo-phase-fill-coa{background:#0FACF1}
.geo-phase-fill-tit{background:#FAD30A}
.geo-table-wrap th{
  background:#241460;
  color:#fff;
}
.geo-diagnosis{
  background:linear-gradient(90deg,#eef8ff,#f7fbff);
  border-left-color:#0FACF1;
  color:#3b3a4d;
}

/* TARJETAS Y TÍTULOS */
.card{
  border:1px solid #e4e8f3;
  box-shadow:0 3px 10px rgba(36,20,96,.05);
}
.card-title{
  color:#241460;
  font-family:'Montserrat','Century Gothic','Aptos','Segoe UI',Arial,sans-serif;
  font-weight:800;
}
.card-sub{color:#716d80}

.donut-center b{color:#241460}
.dot.teal{background:#241460}
.dot.gold{background:#0FACF1}
.dot.green{background:#FAD30A}
.legend-row b{color:#241460}

/* BARRAS Y CONCENTRACIÓN */
.track{background:#e9edf7}
.conc-fill{
  background:linear-gradient(90deg,#241460,#0FACF1);
}
.fill-teal{background:#0FACF1}
.fill-gold{background:#FAD30A}
.fill-blue{background:#2A3082}
.fill-purple{background:#241460}
.toptrack{background:#e9edf7}
.topfill{
  background:linear-gradient(90deg,#241460,#0FACF1);
}
.rubfill{
  background:linear-gradient(90deg,#2A3082,#5FC0EE);
}
.topvalue b{color:#241460}
.topvalue span{color:#716d80}

/* INSIGHT EJECUTIVO */
.insight{
  background:linear-gradient(90deg,#eef8ff,#f7fbff);
  border-left-color:#0FACF1;
  color:#3a3a4c;
}

/* SEGMENTACIÓN DE RIESGO */
.risk-box.critical{background:#fbe9e6;color:#a63a2d}
.risk-box.high{background:#fff4cc;color:#806000}
.risk-box.medium{background:#eaf7fd;color:#126e9b}
.risk-box.low{background:#eaf5ef;color:#24694F}
.risk.critical{background:#fbe9e6;color:#a63a2d}
.risk.high{background:#fff4cc;color:#806000}
.risk.medium{background:#eaf7fd;color:#126e9b}
.risk.low{background:#eaf5ef;color:#24694F}

/* GEOGRAFÍA */
.geo-line b{color:#241460}

/* TABLAS */
th{
  background:#241460;
  color:#fff;
  font-weight:800;
  border-bottom:2px solid #0FACF1;
}
td{color:#303044}
tbody tr:nth-child(even){background:#f8f9fd}
.contrib{color:#241460}

/* CONTRIBUYENTE SELECCIONADO */
.selected{
  background:linear-gradient(135deg,#fafbff,#f1f7fd);
  border-color:#dfe5f4;
}
.selected-name{color:#241460}
.selected-kpis b{color:#241460}

/* PIE DE PÁGINA */
.footer{
  color:#4c4770;
  border-top:3px solid transparent;
  border-image:linear-gradient(
    90deg,
    #0FACF1 0%,
    #0FACF1 38%,
    #241460 38%,
    #241460 76%,
    #FAD30A 76%,
    #FAD30A 100%
  ) 1;
  margin-top:4px;
  padding-top:10px;
}

/* Refuerzo tipográfico institucional */
.kpi-label,
.filter label,
.geo-alert-label,
.geo-mini .lbl,
th,
.risk,
.hero-badge{
  letter-spacing:.25px;
}


/* ============================================================
   LEGIBILIDAD EJECUTIVA GLOBAL · POWER BI
   Objetivo:
   - lectura cómoda a primera vista;
   - números claramente diferenciados;
   - menos texto comprimido;
   - mayor espacio útil para etiquetas y montos;
   - evitar que nombres/rubros importantes queden ilegibles.
   ============================================================ */

/* ---------- RUBROS BLOQUEADOS / TABLAS EJECUTIVAS ---------- */
.nogeo-rubros{
  padding:17px 16px;
}
.nogeo-rubros-head{
  gap:18px;
  margin-bottom:12px;
}
.nogeo-rubros-head h3{
  font-size:19px;
  line-height:1.25;
}
.nogeo-rubros-head p{
  font-size:11.5px;
  line-height:1.45;
  margin-top:5px;
}
.nogeo-rubros-summary{
  font-size:10.5px;
  line-height:1.4;
  max-width:36%;
  white-space:normal;
}
.nogeo-rubros-summary b{
  font-size:21px;
  margin-bottom:4px;
}
.nogeo-table-wrap{
  max-height:430px;
  overflow-y:auto;
  overflow-x:hidden;
}
.nogeo-table{
  table-layout:fixed;
}
.nogeo-table th{
  font-size:10.2px;
  line-height:1.2;
  padding:10px 9px;
}
.nogeo-table td{
  font-size:11.2px;
  line-height:1.35;
  padding:10px 9px;
}
.nogeo-rubro{
  font-size:11.2px;
  line-height:1.35;
  white-space:normal;
  overflow:visible;
  text-overflow:clip;
  font-weight:750;
}
.nogeo-table .num,
.nogeo-table .money,
.nogeo-table .center{
  font-variant-numeric:tabular-nums;
}
.nogeo-table .money.strong{
  font-size:11.5px;
}
.nogeo-note{
  font-size:10.8px;
  line-height:1.5;
  padding:10px 12px;
  margin-top:10px;
}

/* ---------- TARJETAS DE DISTRIBUCIÓN ---------- */
.card{
  padding:18px;
}
.card-title{
  font-size:18px;
  line-height:1.25;
  margin-bottom:13px;
}
.card-sub{
  font-size:11.5px;
  line-height:1.45;
  margin-top:-4px;
  margin-bottom:14px;
}

/* Distribuciones horizontales:
   más espacio para etiqueta y número, sin sacrificar demasiado la barra */
.hbar{
  grid-template-columns:minmax(128px,145px) minmax(80px,1fr) 78px;
  gap:10px;
  margin:11px 0;
  font-size:11.5px;
  line-height:1.25;
}
.hbar > span{
  font-size:11.5px;
  line-height:1.25;
}
.hbar b{
  font-size:11.5px;
  font-weight:800;
  text-align:right;
  font-variant-numeric:tabular-nums;
}
.track{
  height:15px;
}

/* ---------- TOP CONTRIBUYENTES / PRINCIPALES RUBROS ---------- */
.toprow{
  grid-template-columns:minmax(190px,230px) minmax(100px,1fr) 112px;
  gap:11px;
  margin:12px 0;
}
.topname{
  font-size:11.2px;
  line-height:1.3;
  font-weight:650;
}
.toptrack{
  height:16px;
}
.topvalue{
  font-size:10.8px;
  line-height:1.35;
  font-variant-numeric:tabular-nums;
}
.topvalue b{
  font-size:11.3px;
  font-weight:800;
}
.topvalue span{
  font-size:10px;
}

/* ---------- PERFIL / LEYENDAS / CONCENTRACIÓN ---------- */
.legend-row{
  grid-template-columns:12px minmax(0,1fr) auto;
  gap:9px;
  padding:10px 0;
  font-size:11.2px;
  line-height:1.35;
}
.legend-row b{
  font-size:11.2px;
  font-variant-numeric:tabular-nums;
}
.conc-row{
  grid-template-columns:88px minmax(80px,1fr) 72px;
  gap:10px;
  margin:12px 0;
  font-size:11.2px;
}
.conc-row b{
  font-size:11.2px;
  font-variant-numeric:tabular-nums;
}

/* ---------- SEGMENTACIÓN OPERATIVA ---------- */
.risk-box{
  padding:15px 13px;
}
.risk-box b{
  font-size:23px;
  line-height:1.15;
}
.risk-box span{
  font-size:11px;
  line-height:1.35;
}
.risk-box .risk-amount{
  font-size:15px;
  margin-top:8px;
}
.risk-box .risk-share{
  font-size:10.5px;
}

/* ---------- TABLAS GENERALES ---------- */
table{
  font-variant-numeric:tabular-nums;
}
th{
  font-size:10px;
  line-height:1.25;
  padding:10px 9px;
}
td{
  font-size:10.8px;
  line-height:1.35;
  padding:10px 9px;
}
.risk{
  font-size:9.5px;
}

/* ---------- TEXTO ANALÍTICO ---------- */
.insight{
  font-size:11.5px;
  line-height:1.6;
  padding:14px 16px;
}
.geo-line{
  font-size:11px;
  line-height:1.4;
  padding:9px 3px;
}
.footer{
  font-size:10.5px;
  line-height:1.5;
}

/* ---------- AJUSTES RESPONSIVOS DENTRO DEL VISUAL ---------- */
@media (max-width:1100px){
  .grid3{
    grid-template-columns:1fr;
  }
  .phase-grid{grid-template-columns:1fr}
  .phase-card .phase-meta{grid-template-columns:1fr}
  .phase-state-metrics{grid-template-columns:1fr 1fr}
  .grid2{    grid-template-columns:1fr;
  }
  .hbar{
    grid-template-columns:135px minmax(70px,1fr) 74px;
  }
  .toprow{
    grid-template-columns:210px minmax(90px,1fr) 105px;
  }
}



/* ============================================================
   TOP AGA · LECTURA EJECUTIVA
   Barra = monto de cartera.
   A la derecha se muestra el monto real, % de cartera y
   contribuyentes únicos para evitar ambigüedad.
   ============================================================ */
.aga-row{
  display:grid;
  grid-template-columns:72px minmax(100px,1fr) 150px;
  gap:11px;
  align-items:center;
  margin:12px 0;
  min-width:0;
}
.aga-name{
  font-size:11.5px;
  line-height:1.25;
  font-weight:800;
  color:#241460;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.aga-track{
  height:16px;
  background:#e9edf7;
  border-radius:9px;
  overflow:hidden;
}
.aga-fill{
  height:100%;
  background:linear-gradient(90deg,#241460 0%,#2A3082 58%,#0FACF1 100%);
  border-radius:9px;
}
.aga-metric{
  text-align:right;
  min-width:0;
  font-variant-numeric:tabular-nums;
}
.aga-metric b{
  display:block;
  font-size:12px;
  line-height:1.25;
  font-weight:800;
  color:#241460;
  white-space:nowrap;
}
.aga-metric span{
  display:block;
  margin-top:2px;
  font-size:9.5px;
  line-height:1.25;
  color:#6d7881;
  white-space:nowrap;
}
@media (max-width:1100px){
  .aga-row{
    grid-template-columns:68px minmax(90px,1fr) 142px;
    gap:9px;
  }
  .aga-metric b{
    font-size:11.5px;
  }
  .aga-metric span{
    font-size:9px;
  }
}


/* ============================================================
   UBICACIÓN TERRITORIAL DE LA SEGMENTACIÓN
   ============================================================ */
.seg-location{
 background:#fff;
 border:1px solid #dfe5eb;
 border-radius:12px;
 padding:16px;
 margin-bottom:10px;
 box-shadow:0 2px 9px rgba(36,20,96,.05)
}
.seg-location-head{
 display:flex;
 justify-content:space-between;
 gap:18px;
 align-items:flex-start;
 margin-bottom:11px
}
.seg-location-head h3{
 margin:0;
 color:#241460;
 font-size:18px;
 font-weight:800
}
.seg-location-head p{
 margin:4px 0 0;
 font-size:11px;
 line-height:1.45;
 color:#68747d
}
.seg-location-badge{
 font-size:9.5px;
 font-weight:800;
 color:#241460;
 background:#eef8ff;
 border:1px solid #9edaf4;
 border-radius:12px;
 padding:6px 9px;
 white-space:nowrap
}
.seg-unlocated-grid{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:8px;
 margin-bottom:11px
}
.seg-unlocated{
 border:1px solid #e3e8ed;
 background:#fafcfd;
 border-radius:9px;
 padding:9px 10px
}
.seg-unlocated.critical{border-top:4px solid #CC4534}
.seg-unlocated.high{border-top:4px solid #FAD30A}
.seg-unlocated.medium{border-top:4px solid #0FACF1}
.seg-unlocated.low{border-top:4px solid #24694F}
.seg-unlocated .lbl{
 display:block;
 font-size:8.5px;
 font-weight:800;
 text-transform:uppercase;
 color:#69757f
}
.seg-unlocated b{
 display:block;
 margin-top:4px;
 font-size:16px;
 color:#241460
}
.seg-unlocated span{
 display:block;
 margin-top:2px;
 font-size:9.5px;
 color:#68747d;
 line-height:1.35
}
.seg-table-wrap{
 max-height:390px;
 overflow-y:auto;
 border:1px solid #e3e8ed;
 border-radius:9px
}
.seg-table{
 width:100%;
 border-collapse:collapse;
 table-layout:fixed
}
.seg-table th{
 position:sticky;
 top:0;
 z-index:2;
 background:#241460;
 color:#fff;
 font-size:9.5px;
 font-weight:800;
 text-transform:uppercase;
 padding:9px 8px;
 border-bottom:3px solid #0FACF1
}
.seg-table td{
 padding:9px 8px;
 border-bottom:1px solid #e7ebef;
 font-size:10.5px;
 line-height:1.3
}
.seg-table tbody tr:nth-child(even){
 background:#fafbfe
}
.seg-parr-name{
 font-weight:750;
 color:#241460
}
.seg-review-parent td{
 background:#f1eff9 !important;
 border-top:2px solid #241460;
 border-bottom:1px solid #d9d4eb
}
.seg-review-parent .seg-parr-name{
 font-weight:900;
 color:#241460
}
.seg-review-icon{
 display:inline-block;
 margin-right:6px;
 font-size:11px;
 color:#241460
}
.seg-review-sub{
 display:block;
 margin-top:2px;
 margin-left:18px;
 font-size:8.5px;
 font-weight:600;
 color:#7c8590;
 text-transform:none
}
.seg-review-child td{
 background:#fbfcfe !important;
 border-bottom:1px solid #edf0f3
}
.seg-review-child .seg-parr-name{
 padding-left:24px;
 font-weight:700;
 color:#4d5660
}
.seg-child-line{
 margin-right:6px;
 color:#a6adb5;
 font-weight:500
}
.seg-status-code{
 display:inline-block;
 min-width:18px;
 padding:1px 4px;
 margin-right:5px;
 border-radius:4px;
 background:#ece9f7;
 color:#241460;
 font-size:8.5px;
 font-weight:900;
 text-align:center
}
.seg-review-child:hover td{
 background:#f5f7fa !important
}
.seg-num{
 text-align:right;
 font-variant-numeric:tabular-nums;
 font-weight:750
}
.seg-num.critical{color:#A63B30}
.seg-num.high{color:#806600}
.seg-num.medium{color:#0877A5}
.seg-num.low{color:#24694F}
.seg-num.total{color:#241460}
.seg-money{
 text-align:right;
 color:#241460;
 font-weight:800;
 font-variant-numeric:tabular-nums
}
.seg-average{
 text-align:right;
 color:#0b607f;
 font-weight:850;
 font-variant-numeric:tabular-nums;
 white-space:nowrap
}
.seg-location-note{
 margin-top:9px;
 padding:8px 10px;
 border-left:4px solid #0FACF1;
 background:#eef8ff;
 border-radius:7px;
 font-size:9.5px;
 line-height:1.45;
 color:#56636d
}

/* ============================================================
   FILTRO VISUAL MULTISELECCIÓN · SEGMENTACIÓN TERRITORIAL
   - Permite activar/desactivar Crítico, Alto, Medio y Bajo.
   - Filtra las filas por presencia del segmento seleccionado.
   - Admite selección múltiple.
   - Contribuyentes, cartera territorial y promedio se recalculan
     para la combinación activa.
   ============================================================ */
.seg-risk-filter-shell{
 margin:0 0 10px
}
.seg-risk-filter-input{
 position:absolute !important;
 width:1px !important;
 height:1px !important;
 opacity:0 !important;
 pointer-events:none !important;
 overflow:hidden !important
}
.seg-risk-filter-bar{
 display:flex;
 align-items:center;
 flex-wrap:wrap;
 gap:6px;
 margin:0 0 8px;
 padding:8px 10px;
 background:#f7f8fb;
 border:1px solid #e1e6ec;
 border-radius:9px
}
.seg-risk-filter-title{
 margin-right:4px;
 color:#596773;
 font-size:9px;
 font-weight:850;
 text-transform:uppercase;
 letter-spacing:.25px
}
.seg-risk-filter-hint{
 margin-left:auto;
 color:#7b8791;
 font-size:8.5px;
 font-weight:650
}
.seg-risk-filter-bar label{
 display:inline-flex;
 align-items:center;
 justify-content:center;
 min-width:78px;
 padding:6px 10px;
 border:1px solid #d8dde4;
 border-radius:8px;
 background:#ffffff;
 color:#5c6770;
 font-size:9px;
 font-weight:900;
 cursor:pointer;
 user-select:none;
 transition:.15s ease
}
.seg-risk-filter-bar label:before{
 content:'';
 width:7px;
 height:7px;
 margin-right:6px;
 border-radius:50%;
 background:#c7cdd3
}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-bar .seg-risk-label-critical{
 background:#CC4534;
 border-color:#CC4534;
 color:#ffffff;
 box-shadow:0 2px 6px rgba(204,69,52,.16)
}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-bar .seg-risk-label-critical:before{
 background:#ffffff
}
.seg-risk-filter-high:checked ~ .seg-risk-filter-bar .seg-risk-label-high{
 background:#FAD30A;
 border-color:#FAD30A;
 color:#241460;
 box-shadow:0 2px 6px rgba(250,211,10,.18)
}
.seg-risk-filter-high:checked ~ .seg-risk-filter-bar .seg-risk-label-high:before{
 background:#241460
}
.seg-risk-filter-medium:checked ~ .seg-risk-filter-bar .seg-risk-label-medium{
 background:#0FACF1;
 border-color:#0FACF1;
 color:#ffffff;
 box-shadow:0 2px 6px rgba(15,172,241,.16)
}
.seg-risk-filter-medium:checked ~ .seg-risk-filter-bar .seg-risk-label-medium:before{
 background:#ffffff
}
.seg-risk-filter-low:checked ~ .seg-risk-filter-bar .seg-risk-label-low{
 background:#24694F;
 border-color:#24694F;
 color:#ffffff;
 box-shadow:0 2px 6px rgba(36,105,79,.16)
}
.seg-risk-filter-low:checked ~ .seg-risk-filter-bar .seg-risk-label-low:before{
 background:#ffffff
}

/* Filtrado de filas: una fila se muestra si coincide con AL MENOS
   uno de los segmentos activos. */
.seg-risk-filter-shell .seg-risk-filter-content .seg-risk-row{
 display:none
}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-content .seg-risk-row.has-critical,
.seg-risk-filter-high:checked ~ .seg-risk-filter-content .seg-risk-row.has-high,
.seg-risk-filter-medium:checked ~ .seg-risk-filter-content .seg-risk-row.has-medium,
.seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-risk-row.has-low{
 display:table-row
}

/* Las columnas de segmentos también siguen el selector. */
.seg-risk-filter-shell .seg-risk-filter-content .seg-table th:nth-child(2),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table td:nth-child(2),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table th:nth-child(3),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table td:nth-child(3),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table th:nth-child(4),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table td:nth-child(4),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table th:nth-child(5),
.seg-risk-filter-shell .seg-risk-filter-content .seg-table td:nth-child(5){
 display:none
}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-content .seg-table th:nth-child(2),
.seg-risk-filter-critical:checked ~ .seg-risk-filter-content .seg-table td:nth-child(2),
.seg-risk-filter-high:checked ~ .seg-risk-filter-content .seg-table th:nth-child(3),
.seg-risk-filter-high:checked ~ .seg-risk-filter-content .seg-table td:nth-child(3),
.seg-risk-filter-medium:checked ~ .seg-risk-filter-content .seg-table th:nth-child(4),
.seg-risk-filter-medium:checked ~ .seg-risk-filter-content .seg-table td:nth-child(4),
.seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-table th:nth-child(5),
.seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-table td:nth-child(5){
 display:table-cell
}

/* Valores dinámicos: contribuyentes, cartera territorial y promedio
   se recalculan visualmente según la combinación activa. */
.seg-dynamic{
 white-space:nowrap
}
.seg-dynamic::after{
 content:'—'
}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-c)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-h)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-m)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-l)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-ch)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-cm)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-cl)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-hm)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-hl)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-ml)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-chm)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-chl)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-cml)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-hml)}
.seg-risk-filter-critical:checked ~ .seg-risk-filter-high:checked ~ .seg-risk-filter-medium:checked ~ .seg-risk-filter-low:checked ~ .seg-risk-filter-content .seg-dynamic::after{content:attr(data-all)}
.seg-risk-filter-critical:not(:checked) ~ .seg-risk-filter-high:not(:checked) ~ .seg-risk-filter-medium:not(:checked) ~ .seg-risk-filter-low:not(:checked) ~ .seg-risk-filter-content .seg-dynamic::after{content:'—'}

@media (max-width:1100px){
 .seg-risk-filter-hint{
  width:100%;
  margin-left:0
 }
 .seg-risk-filter-bar label{
  min-width:72px;
  flex:1 1 72px
 }
}

.seg-sector-analysis{
 margin-top:12px
}
.seg-sector-grid .seg-unlocated b{
 font-size:14px;
 line-height:1.25;
 white-space:normal;
 overflow-wrap:anywhere
}
.seg-sector-grid .seg-unlocated span,
.seg-parish-grid .seg-unlocated span{
 line-height:1.4
}

/* ============================================================
   SELECTOR MAESTRO TERRITORIAL · SOLO HTML/CSS
   No modifica filtros del modelo; alterna la vista renderizada.
   ============================================================ */
.territorial-phase-shell{
 margin-bottom:10px
}
.territorial-phase-input{
 position:absolute !important;
 width:1px !important;
 height:1px !important;
 opacity:0 !important;
 pointer-events:none !important;
 overflow:hidden !important
}
.territorial-phase-tabs{
 display:flex;
 align-items:center;
 justify-content:center;
 gap:6px;
 margin-bottom:8px
}
.territorial-phase-tabs label{
 min-width:118px;
 padding:8px 16px;
 border-radius:9px;
 border:1px solid #d7dce4;
 background:#ffffff;
 color:#241460;
 font-size:10px;
 font-weight:900;
 text-align:center;
 cursor:pointer;
 box-shadow:0 1px 4px rgba(36,20,96,.05)
}
.territorial-phase-view{
 display:none
}
#territorial-phase-general:checked ~ .territorial-phase-tabs label[for='territorial-phase-general']{
 background:#FAD30A;
 border-color:#FAD30A;
 color:#241460
}
#territorial-phase-coa:checked ~ .territorial-phase-tabs label[for='territorial-phase-coa']{
 background:#241460;
 border-color:#241460;
 color:#ffffff
}
#territorial-phase-tit:checked ~ .territorial-phase-tabs label[for='territorial-phase-tit']{
 background:#0FACF1;
 border-color:#0FACF1;
 color:#241460
}
#territorial-phase-general:checked ~ .territorial-general-phase-view{display:block}
#territorial-phase-coa:checked ~ .territorial-coa-phase-view{display:block}
#territorial-phase-tit:checked ~ .territorial-tit-phase-view{display:block}
.territorial-inner-badge{
 display:inline-block;
 margin-left:8px;
 padding:3px 8px;
 border-radius:11px;
 font-size:8px;
 font-weight:900;
 vertical-align:middle
}
.territorial-inner-badge.general{
 background:#FAD30A;
 color:#241460
}
.territorial-inner-badge.coa{
 background:#241460;
 color:#ffffff
}
.territorial-inner-badge.tit{
 background:#0FACF1;
 color:#241460
}

.territorial-master{
 margin-bottom:10px
}
.territorial-master-head{
 background:#fff;
 border:1px solid #dfe5eb;
 border-radius:12px 12px 0 0;
 padding:15px 16px 13px;
 box-shadow:0 2px 9px rgba(36,20,96,.05)
}
.territorial-master-head h3{
 margin:0;
 color:#241460;
 font-size:19px;
 font-weight:850
}
.territorial-master-head p{
 margin:4px 0 0;
 color:#68747d;
 font-size:10.5px;
 line-height:1.45
}
.territorial-switch-input{
 position:absolute !important;
 width:1px !important;
 height:1px !important;
 opacity:0 !important;
 pointer-events:none !important;
 overflow:hidden !important
}
.territorial-switch-tabs{
 display:flex;
 align-items:center;
 justify-content:center;
 gap:6px;
 background:#f7f8fb;
 border-left:1px solid #dfe5eb;
 border-right:1px solid #dfe5eb;
 padding:10px 12px
}
.territorial-switch-tabs label{
 min-width:125px;
 padding:8px 20px;
 border:1px solid #cfc9e4;
 border-radius:8px;
 background:#fff;
 color:#241460;
 font-size:10px;
 font-weight:900;
 letter-spacing:.35px;
 text-align:center;
 cursor:pointer;
 user-select:none;
 box-shadow:0 1px 4px rgba(36,20,96,.05)
}
.territorial-switch-tabs label:hover{
 background:#f0eef9
}
.territorial-view{
 display:none
}
/* Selector interno PARROQUIA / SECTOR · GENERAL */
#territorial-parroquia-gen:checked ~ .territorial-parroquia-gen-view{
 display:block
}
#territorial-sector-gen:checked ~ .territorial-sector-gen-view{
 display:block
}
#territorial-parroquia-gen:checked ~ .territorial-switch-tabs label[for='territorial-parroquia-gen'],
#territorial-sector-gen:checked ~ .territorial-switch-tabs label[for='territorial-sector-gen']{
 background:#FAD30A;
 border-color:#FAD30A;
 color:#241460;
 box-shadow:0 2px 7px rgba(36,20,96,.14)
}

/* Selector interno PARROQUIA / SECTOR · COACTIVA */
#territorial-parroquia-coa:checked ~ .territorial-parroquia-coa-view{
 display:block
}
#territorial-sector-coa:checked ~ .territorial-sector-coa-view{
 display:block
}
#territorial-parroquia-coa:checked ~ .territorial-switch-tabs label[for='territorial-parroquia-coa'],
#territorial-sector-coa:checked ~ .territorial-switch-tabs label[for='territorial-sector-coa']{
 background:#241460;
 border-color:#241460;
 color:#ffffff;
 box-shadow:0 2px 7px rgba(36,20,96,.18)
}

/* Selector interno PARROQUIA / SECTOR · TÍTULOS */
#territorial-parroquia-tit:checked ~ .territorial-parroquia-tit-view{
 display:block
}
#territorial-sector-tit:checked ~ .territorial-sector-tit-view{
 display:block
}
#territorial-parroquia-tit:checked ~ .territorial-switch-tabs label[for='territorial-parroquia-tit'],
#territorial-sector-tit:checked ~ .territorial-switch-tabs label[for='territorial-sector-tit']{
 background:#0FACF1;
 border-color:#0FACF1;
 color:#241460;
 box-shadow:0 2px 7px rgba(15,172,241,.18)
}
.territorial-view .seg-location{
 border-radius:0 0 12px 12px;
 border-top:1px solid #e6e2f2;
 margin-bottom:0
}
.territorial-view .seg-sector-analysis{
 margin-top:0
}
.territorial-mode-tag{
 display:inline-block;
 margin-left:7px;
 padding:3px 7px;
 border-radius:10px;
 background:#eef8ff;
 color:#0877A5;
 border:1px solid #9edaf4;
 font-size:8px;
 font-weight:900;
 vertical-align:middle
}

</style>

<div class='dashboard'>

<div class='hero'>
 <div class='hero-row'>
  <div>
   <h1>Dashboard Ejecutivo de Contribuyentes · PRO+</h1>
   <p>Análisis ejecutivo de cartera, fase, segmentación, territorio y capacidad operativa de notificación.</p>
  </div>
  <div class='hero-meta'>
   <div class='hero-badge'>Universo ampliado: COACTIVA + TÍTULOS</div>
   <div class='hero-cutoff'>Fecha de corte:<strong>" & _FechaCorteTexto & "</strong></div>
  </div>
 </div>
</div>

<div class='filters'>
 <div class='filter'><label>Fase</label><div>" & _FiltroFase & "</div></div>
 <div class='filter'><label>Año</label><div>" & _FiltroAnio & "</div></div>
 <div class='filter'><label>Rubro</label><div title='" & _FiltroRubro & "'>" & _FiltroRubro & "</div></div>
 <div class='filter'><label>AGA</label><div>" & _FiltroAGA & "</div></div>
 <div class='filter'><label>Parroquia</label><div title='" & _FiltroParroquia & "'>" & _FiltroParroquia & "</div></div>
 <div class='filter'><label>Sector</label><div title='" & _FiltroSector & "'>" & _FiltroSector & "</div></div>
 <div class='filter'><label>Estado</label><div title='" & _FiltroEstado & "'>" & _FiltroEstado & "</div></div>
 <div class='filter'><label>Antigüedad</label><div title='" & _FiltroEdad & "'>" & _FiltroEdad & "</div></div>
</div>

<div class='kpis'>
 <div class='kpi'><div class='kpi-label'>Contribuyentes</div><div class='kpi-value'>" & FORMAT(_Contribuyentes,"#,##0") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Cartera</div><div class='kpi-value'>" & FORMAT(_Cartera,"$ #,##0.00") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Deuda promedio</div><div class='kpi-value'>" & FORMAT(_DeudaPromedio,"$ #,##0.00") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Obligaciones totales</div><div class='kpi-value'>" & FORMAT(_Obligaciones,"#,##0") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Oblig. promedio</div><div class='kpi-value'>" & FORMAT(_ObligPromedio,"0.00") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Mayor exposición</div><div class='kpi-value'>" & FORMAT(_MayorExposicion,"$ #,##0.00") & "</div></div>
 <div class='kpi'><div class='kpi-label'>Contrib. notificables</div><div class='kpi-value'>" & FORMAT(_PctContribNotificablesHoy,"0.0%") & "</div></div>
</div>

<div class='phase-analysis'>
 <div class='phase-analysis-head'>
  <div>
   <h3>Composición de cartera por fase</h3>
   <p>Permite comparar la exposición de Títulos y Coactiva dentro del universo filtrado, respetando el flujo operativo donde la deuda nace en Títulos y, si no se recupera, pasa a Coactiva.</p>
  </div>
  <div class='phase-analysis-badge'>TÍTULOS vs COACTIVA</div>
 </div>

 <div class='phase-grid'>
  <div class='phase-card tit'>
   <div class='phase-label'>
    <b>Títulos</b>
    <span class='phase-share'>" & FORMAT(_PctCarteraTitulosTotal,"0.0%") & " de la cartera</span>
   </div>
   <div class='phase-amount'>" & FORMAT(_CarteraTitulosTotal,"$ #,##0.00") & "</div>
   <div class='phase-meta'>
    <div>
     <span>Contribuyentes</span>
     <strong>" & FORMAT(_ContribuyentesTitulosTotal,"#,##0") & "</strong>
    </div>
    <div>
     <span>Obligaciones</span>
     <strong>" & FORMAT(_ObligacionesTitulosTotal,"#,##0") & "</strong>
    </div>
    <div>
     <span>Promedio / contrib.</span>
     <strong>" & FORMAT(_PromedioTitulosPorContribuyente,"$ #,##0.00") & "</strong>
    </div>
   </div>

   <div class='phase-state-block'>
    <div class='phase-state-title'>
     <b>Desglose por estado</b>
     <span>Estados activos en el filtro</span>
    </div>
    " & _HtmlEstadosTitulos & "
   </div>
  </div>

  <div class='phase-card coa'>
   <div class='phase-label'>
    <b>Coactiva</b>
    <span class='phase-share'>" & FORMAT(_PctCarteraCoactivaTotal,"0.0%") & " de la cartera</span>
   </div>
   <div class='phase-amount'>" & FORMAT(_CarteraCoactivaTotal,"$ #,##0.00") & "</div>
   <div class='phase-meta'>
    <div>
     <span>Contribuyentes</span>
     <strong>" & FORMAT(_ContribuyentesCoactivaTotal,"#,##0") & "</strong>
    </div>
    <div>
     <span>Obligaciones</span>
     <strong>" & FORMAT(_ObligacionesCoactivaTotal,"#,##0") & "</strong>
    </div>
    <div>
     <span>Promedio / contrib.</span>
     <strong>" & FORMAT(_PromedioCoactivaPorContribuyente,"$ #,##0.00") & "</strong>
    </div>
   </div>

   <div class='phase-state-block'>
    <div class='phase-state-title'>
     <b>Desglose por estado</b>
     <span>Estados activos en el filtro</span>
    </div>
    " & _HtmlEstadosCoactiva & "
   </div>
  </div>
 </div>

 <div class='phase-composition'>
  <div class='phase-bar'>
   <div class='tit' style='width:" & _WTitulosFase & "%'></div>
   <div class='coa' style='width:" & _WCoactivaFase & "%'></div>
  </div>
  <div class='phase-legend'>
   <span><b>Títulos:</b> " & FORMAT(_PctCarteraTitulosTotal,"0.0%") & "</span>
   <span><b>Coactiva:</b> " & FORMAT(_PctCarteraCoactivaTotal,"0.0%") & "</span>
  </div>
 </div>

 <div class='phase-reading'>
  <b>Lectura ejecutiva:</b> " & _MensajeEjecutivoFases & "
 </div>
</div>

<div class='card' style='margin-bottom:10px'>
 <div class='card-title'>Segmentación operativa de contribuyentes</div>
 <div class='card-sub'>Clasificación orientativa por monto y recurrencia dentro del filtro actual.</div>
 <div class='risk-grid'>
  <div class='risk-box critical'>
   <b>" & FORMAT(_Criticos,"#,##0") & "</b>
   <span>Críticos · " & FORMAT(_PctCriticos,"0.0%") & " de contribuyentes</span>
   <span class='risk-amount'>" & FORMAT(_MontoCriticos,"$ #,##0.00") & "</span>
   <span class='risk-share'>" & FORMAT(_PctCarteraCriticos,"0.0%") & " de la cartera</span>
  </div>
  <div class='risk-box high'>
   <b>" & FORMAT(_Altos,"#,##0") & "</b>
   <span>Altos · " & FORMAT(_PctAltos,"0.0%") & " de contribuyentes</span>
   <span class='risk-amount'>" & FORMAT(_MontoAltos,"$ #,##0.00") & "</span>
   <span class='risk-share'>" & FORMAT(_PctCarteraAltos,"0.0%") & " de la cartera</span>
  </div>
  <div class='risk-box medium'>
   <b>" & FORMAT(_Medios,"#,##0") & "</b>
   <span>Medios · " & FORMAT(_PctMedios,"0.0%") & " de contribuyentes</span>
   <span class='risk-amount'>" & FORMAT(_MontoMedios,"$ #,##0.00") & "</span>
   <span class='risk-share'>" & FORMAT(_PctCarteraMedios,"0.0%") & " de la cartera</span>
  </div>
  <div class='risk-box low'>
   <b>" & FORMAT(_Bajos,"#,##0") & "</b>
   <span>Bajos · " & FORMAT(_PctBajos,"0.0%") & " de contribuyentes</span>
   <span class='risk-amount'>" & FORMAT(_MontoBajos,"$ #,##0.00") & "</span>
   <span class='risk-share'>" & FORMAT(_PctCarteraBajos,"0.0%") & " de la cartera</span>
  </div>
 </div>
</div>

<div class='territorial-phase-shell'>
 <input class='territorial-phase-input' type='radio' id='territorial-phase-general' name='territorial-phase-master' checked='checked'/>
 <input class='territorial-phase-input' type='radio' id='territorial-phase-tit' name='territorial-phase-master'/>
 <input class='territorial-phase-input' type='radio' id='territorial-phase-coa' name='territorial-phase-master'/>

 <div class='territorial-phase-tabs'>
  <label for='territorial-phase-general'>GENERAL</label>
  <label for='territorial-phase-tit'>TÍTULOS</label>
  <label for='territorial-phase-coa'>COACTIVA</label>
 </div>

 <div class='territorial-phase-view territorial-general-phase-view'>
<div class='territorial-master'>
 <input class='territorial-switch-input' type='radio' id='territorial-parroquia-gen' name='territorial-master-view-gen' checked='checked'/>
 <input class='territorial-switch-input' type='radio' id='territorial-sector-gen' name='territorial-master-view-gen'/>

 <div class='territorial-master-head'>
  <h3>Ubicación territorial de la segmentación <span class='territorial-inner-badge general'>GENERAL</span></h3>
  <p>Vista consolidada de Títulos + Coactiva. Use los botones superiores para alternar la fase sin salir del dashboard.</p>
 </div>

 <div class='territorial-switch-tabs'>
  <label for='territorial-parroquia-gen'>PARROQUIA</label>
  <label for='territorial-sector-gen'>SECTOR</label>
 </div>

 <div class='territorial-view territorial-parroquia-gen-view'>
<div class='seg-location'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por parroquia <span class='territorial-mode-tag'>PARROQUIA</span></h3>
   <p>Permite identificar en qué parroquias existe presencia de contribuyentes Críticos, Altos, Medios y Bajos dentro del filtro actual.</p>
  </div>
  <div class='seg-location-badge'>Prioridad territorial = Mayor promedio / contribuyente</div>
 </div>

 <div class='seg-unlocated-grid seg-parish-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Parroquias analizadas</span>
   <b>" & FORMAT(_CantidadParroquiasAnalizadas,"#,##0") & "</b>
   <span>" & FORMAT(_ParroquiasConPrioridad,"#,##0") & " con presencia Crítica o Alta</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Mayor prioridad territorial</span>
   <b>" & _TopParroquiaPrioridadNombre & "</b>
   <span>" & FORMAT(_TopParroquiaPrioridadPromedio,"$ #,##0.00") & " promedio por contribuyente</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Mayor cartera parroquial</span>
   <b>" & _TopParroquiaCarteraNombre & "</b>
   <span>" & FORMAT(_TopParroquiaCarteraMonto,"$ #,##0.00") & " de cartera</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Concentración Top 5 parroquias</span>
   <b>" & FORMAT(_PctCarteraTop5Parroquias,"0.0%") & "</b>
   <span>" & FORMAT(_CarteraTop5Parroquias,"$ #,##0.00") & " de cartera con parroquia informada</span>
  </div>
 </div>

 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-parr-gen-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-parr-gen-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-parr-gen-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-parr-gen-low' checked='checked'/>

  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-parr-gen-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-parr-gen-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-parr-gen-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-parr-gen-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · la tabla recalcula contribuyentes, cartera y promedio</span>
  </div>

  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
  <table class='seg-table'>
   <thead>
    <tr>
     <th style='width:22%;text-align:left'>Parroquia / ubicación</th>
     <th style='width:8%;text-align:right'>Críticos</th>
     <th style='width:8%;text-align:right'>Altos</th>
     <th style='width:8%;text-align:right'>Medios</th>
     <th style='width:8%;text-align:right'>Bajos</th>
     <th style='width:10%;text-align:right'>Contribuyentes</th>
     <th style='width:18%;text-align:right'>Cartera territorial</th>
     <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
    </tr>
   </thead>
   <tbody>
    " & _HtmlSegmentacionParroquia & _HtmlBrechas_GENERAL & "
   </tbody>
  </table>
 </div>
  </div>
 </div>

 <div class='seg-location-note'>
  <b>Lectura ejecutiva:</b> " & _MensajeEjecutivoParroquia & "<br/>
  La tabla conserva el <b>orden territorial del universo completo</b> para evitar saltos visuales. Al activar o desactivar segmentos, <b>Contribuyentes, Cartera territorial y Promedio / contribuyente</b> se recalculan para la selección activa.
  Un mismo contribuyente puede aparecer en más de una parroquia cuando mantiene obligaciones asociadas a distintos territorios.
  Al final de la tabla, <b>REVISAR UBICACIÓN</b> desglosa la brecha territorial en: sin ubicación, sin coordenadas, sin parroquia y sin sector. Estas filas no participan en el ranking ni en el Top 5 territorial.
 </div>
</div>
 </div>

 <div class='territorial-view territorial-sector-gen-view'>
<div class='seg-location seg-sector-analysis'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por sector <span class='territorial-mode-tag'>SECTOR</span></h3>
   <p>Complementa la lectura por parroquia y permite identificar en qué sectores se concentra la presencia de contribuyentes Críticos, Altos, Medios y Bajos.</p>
  </div>
  <div class='seg-location-badge'>Prioridad sectorial = Mayor promedio / contribuyente</div>
 </div>

 <div class='seg-unlocated-grid seg-sector-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Sectores analizados</span>
   <b>" & FORMAT(_CantidadSectoresAnalizados,"#,##0") & "</b>
   <span>" & FORMAT(_SectoresConPrioridad,"#,##0") & " con presencia Crítica o Alta</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Mayor prioridad territorial</span>
   <b>" & _TopSectorPrioridadNombre & "</b>
   <span>" & FORMAT(_TopSectorPrioridadPromedio,"$ #,##0.00") & " promedio por contribuyente</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Mayor cartera sectorial</span>
   <b>" & _TopSectorCarteraNombre & "</b>
   <span>" & FORMAT(_TopSectorCarteraMonto,"$ #,##0.00") & " de cartera</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Concentración Top 5 sectores</span>
   <b>" & FORMAT(_PctCarteraTop5Sectores,"0.0%") & "</b>
   <span>" & FORMAT(_CarteraTop5Sectores,"$ #,##0.00") & " de cartera con sector informado</span>
  </div>
 </div>

 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-sector-gen-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-sector-gen-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-sector-gen-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-sector-gen-low' checked='checked'/>

  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-sector-gen-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-sector-gen-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-sector-gen-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-sector-gen-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · la tabla recalcula contribuyentes, cartera y promedio</span>
  </div>

  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
  <table class='seg-table'>
   <thead>
    <tr>
     <th style='width:22%;text-align:left'>Sector / nomenclatura</th>
     <th style='width:8%;text-align:right'>Críticos</th>
     <th style='width:8%;text-align:right'>Altos</th>
     <th style='width:8%;text-align:right'>Medios</th>
     <th style='width:8%;text-align:right'>Bajos</th>
     <th style='width:10%;text-align:right'>Contribuyentes</th>
     <th style='width:18%;text-align:right'>Cartera territorial</th>
     <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
    </tr>
   </thead>
   <tbody>
    " & _HtmlSegmentacionSector & _HtmlBrechas_GENERAL & "
   </tbody>
  </table>
 </div>
  </div>
 </div>

 <div class='seg-location-note'>
  <b>Lectura ejecutiva:</b> " & _MensajeEjecutivoSector & "<br/>
  La tabla conserva el <b>orden territorial del universo completo</b> para evitar saltos visuales. Al activar o desactivar segmentos, <b>Contribuyentes, Cartera territorial y Promedio / contribuyente</b> se recalculan para la selección activa.
  Un mismo contribuyente puede aparecer en más de un sector cuando mantiene obligaciones asociadas a distintos sectores.
  Al final de la tabla, <b>REVISAR UBICACIÓN</b> desglosa la brecha territorial en: sin ubicación, sin coordenadas, sin parroquia y sin sector. Estas filas no participan en el ranking ni en el Top 5 territorial.
 </div>
</div>
 </div>
</div>

 </div>

 <div class='territorial-phase-view territorial-tit-phase-view'>
<div class='territorial-master'>
 <input class='territorial-switch-input' type='radio' id='territorial-parroquia-tit' name='territorial-master-view-tit' checked='checked'/>
 <input class='territorial-switch-input' type='radio' id='territorial-sector-tit' name='territorial-master-view-tit'/>

 <div class='territorial-master-head'>
  <h3>Ubicación territorial de la segmentación <span class='territorial-inner-badge tit'>TÍTULOS</span></h3>
  <p>Vista interna por fase. Reutiliza la segmentación consolidada del contribuyente y recalcula únicamente presencia, cartera y promedio territorial de Títulos.</p>
 </div>

 <div class='territorial-switch-tabs'>
  <label for='territorial-parroquia-tit'>PARROQUIA</label>
  <label for='territorial-sector-tit'>SECTOR</label>
 </div>

 <div class='territorial-view territorial-parroquia-tit-view'>
<div class='seg-location'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por parroquia <span class='territorial-mode-tag'>PARROQUIA</span></h3>
   <p>Distribución territorial de Títulos según los segmentos consolidados Crítico, Alto, Medio y Bajo.</p>
  </div>
  <div class='seg-location-badge'>TÍTULOS · vista territorial</div>
 </div>

 <div class='seg-unlocated-grid seg-parish-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Parroquias analizadas</span>
   <b>" & FORMAT(_CantidadParroquiasAnalizadas_TIT,"#,##0") & "</b>
   <span>con cartera de Títulos en el filtro actual</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Cartera de la fase</span>
   <b>" & FORMAT(_CarteraTitulosTotal,"$ #,##0.00") & "</b>
   <span>monto considerado en Títulos</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Contribuyentes</span>
   <b>" & FORMAT(_ContribuyentesTitulosTotal,"#,##0") & "</b>
   <span>con presencia en la fase</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Promedio / contribuyente</span>
   <b>" & FORMAT(_PromedioTitulosPorContribuyente,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_ObligacionesTitulosTotal,"#,##0") & " obligaciones</span>
  </div>
 </div>

 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-parr-tit-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-parr-tit-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-parr-tit-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-parr-tit-low' checked='checked'/>
  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-parr-tit-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-parr-tit-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-parr-tit-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-parr-tit-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · recalcula contribuyentes, cartera y promedio dentro de Títulos</span>
  </div>
  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
    <table class='seg-table'>
     <thead><tr>
      <th style='width:22%;text-align:left'>Parroquia / ubicación</th>
      <th style='width:8%;text-align:right'>Críticos</th>
      <th style='width:8%;text-align:right'>Altos</th>
      <th style='width:8%;text-align:right'>Medios</th>
      <th style='width:8%;text-align:right'>Bajos</th>
      <th style='width:10%;text-align:right'>Contribuyentes</th>
      <th style='width:18%;text-align:right'>Cartera territorial</th>
      <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
     </tr></thead>
     <tbody>" & _HtmlSegmentacionParroquia_TIT & _HtmlBrechas_TIT & "</tbody>
    </table>
   </div>
  </div>
 </div>
 <div class='seg-location-note'>
  <b>Criterio:</b> la clasificación Crítico/Alto/Medio/Bajo se mantiene por exposición consolidada del contribuyente. Al final se incluye <b>REVISAR UBICACIÓN</b> con el desglose 01-04 de calidad territorial.
 </div>
</div>
 </div>

 <div class='territorial-view territorial-sector-tit-view'>
<div class='seg-location seg-sector-analysis'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por sector <span class='territorial-mode-tag'>SECTOR</span></h3>
   <p>Distribución sectorial de Títulos según la misma segmentación consolidada.</p>
  </div>
  <div class='seg-location-badge'>TÍTULOS · vista territorial</div>
 </div>
 <div class='seg-unlocated-grid seg-sector-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Sectores analizados</span>
   <b>" & FORMAT(_CantidadSectoresAnalizados_TIT,"#,##0") & "</b>
   <span>con cartera de Títulos en el filtro actual</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Cartera de la fase</span>
   <b>" & FORMAT(_CarteraTitulosTotal,"$ #,##0.00") & "</b>
   <span>monto considerado en Títulos</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Contribuyentes</span>
   <b>" & FORMAT(_ContribuyentesTitulosTotal,"#,##0") & "</b>
   <span>con presencia en la fase</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Promedio / contribuyente</span>
   <b>" & FORMAT(_PromedioTitulosPorContribuyente,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_ObligacionesTitulosTotal,"#,##0") & " obligaciones</span>
  </div>
 </div>
 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-sector-tit-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-sector-tit-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-sector-tit-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-sector-tit-low' checked='checked'/>
  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-sector-tit-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-sector-tit-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-sector-tit-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-sector-tit-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · recalcula contribuyentes, cartera y promedio dentro de Títulos</span>
  </div>
  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
    <table class='seg-table'>
     <thead><tr>
      <th style='width:22%;text-align:left'>Sector / nomenclatura</th>
      <th style='width:8%;text-align:right'>Críticos</th>
      <th style='width:8%;text-align:right'>Altos</th>
      <th style='width:8%;text-align:right'>Medios</th>
      <th style='width:8%;text-align:right'>Bajos</th>
      <th style='width:10%;text-align:right'>Contribuyentes</th>
      <th style='width:18%;text-align:right'>Cartera territorial</th>
      <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
     </tr></thead>
     <tbody>" & _HtmlSegmentacionSector_TIT & _HtmlBrechas_TIT & "</tbody>
    </table>
   </div>
  </div>
 </div>
 <div class='seg-location-note'>
  <b>Criterio:</b> la clasificación de riesgo permanece consolidada; la pestaña separa únicamente el saldo correspondiente a Títulos. Al final, <b>REVISAR UBICACIÓN</b> desglosa la brecha territorial de Títulos.
 </div>
</div>
 </div>
</div>
 </div>

 <div class='territorial-phase-view territorial-coa-phase-view'>
<div class='territorial-master'>
 <input class='territorial-switch-input' type='radio' id='territorial-parroquia-coa' name='territorial-master-view-coa' checked='checked'/>
 <input class='territorial-switch-input' type='radio' id='territorial-sector-coa' name='territorial-master-view-coa'/>

 <div class='territorial-master-head'>
  <h3>Ubicación territorial de la segmentación <span class='territorial-inner-badge coa'>COACTIVA</span></h3>
  <p>Vista interna por fase. Reutiliza la segmentación consolidada del contribuyente y recalcula únicamente presencia, cartera y promedio territorial de Coactiva.</p>
 </div>

 <div class='territorial-switch-tabs'>
  <label for='territorial-parroquia-coa'>PARROQUIA</label>
  <label for='territorial-sector-coa'>SECTOR</label>
 </div>

 <div class='territorial-view territorial-parroquia-coa-view'>
<div class='seg-location'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por parroquia <span class='territorial-mode-tag'>PARROQUIA</span></h3>
   <p>Distribución territorial de Coactiva según los segmentos consolidados Crítico, Alto, Medio y Bajo.</p>
  </div>
  <div class='seg-location-badge'>COACTIVA · vista territorial</div>
 </div>

 <div class='seg-unlocated-grid seg-parish-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Parroquias analizadas</span>
   <b>" & FORMAT(_CantidadParroquiasAnalizadas_COA,"#,##0") & "</b>
   <span>con cartera de Coactiva en el filtro actual</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Cartera de la fase</span>
   <b>" & FORMAT(_CarteraCoactivaTotal,"$ #,##0.00") & "</b>
   <span>monto considerado en Coactiva</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Contribuyentes</span>
   <b>" & FORMAT(_ContribuyentesCoactivaTotal,"#,##0") & "</b>
   <span>con presencia en la fase</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Promedio / contribuyente</span>
   <b>" & FORMAT(_PromedioCoactivaPorContribuyente,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_ObligacionesCoactivaTotal,"#,##0") & " obligaciones</span>
  </div>
 </div>

 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-parr-coa-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-parr-coa-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-parr-coa-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-parr-coa-low' checked='checked'/>
  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-parr-coa-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-parr-coa-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-parr-coa-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-parr-coa-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · recalcula contribuyentes, cartera y promedio dentro de Coactiva</span>
  </div>
  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
    <table class='seg-table'>
     <thead><tr>
      <th style='width:22%;text-align:left'>Parroquia / ubicación</th>
      <th style='width:8%;text-align:right'>Críticos</th>
      <th style='width:8%;text-align:right'>Altos</th>
      <th style='width:8%;text-align:right'>Medios</th>
      <th style='width:8%;text-align:right'>Bajos</th>
      <th style='width:10%;text-align:right'>Contribuyentes</th>
      <th style='width:18%;text-align:right'>Cartera territorial</th>
      <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
     </tr></thead>
     <tbody>" & _HtmlSegmentacionParroquia_COA & _HtmlBrechas_COA & "</tbody>
    </table>
   </div>
  </div>
 </div>
 <div class='seg-location-note'>
  <b>Criterio:</b> la clasificación Crítico/Alto/Medio/Bajo se mantiene por exposición consolidada del contribuyente. Al final se incluye <b>REVISAR UBICACIÓN</b> con el desglose 01-04 de calidad territorial.
 </div>
</div>
 </div>

 <div class='territorial-view territorial-sector-coa-view'>
<div class='seg-location seg-sector-analysis'>
 <div class='seg-location-head'>
  <div>
   <h3>Análisis por sector <span class='territorial-mode-tag'>SECTOR</span></h3>
   <p>Distribución sectorial de Coactiva según la misma segmentación consolidada.</p>
  </div>
  <div class='seg-location-badge'>COACTIVA · vista territorial</div>
 </div>
 <div class='seg-unlocated-grid seg-sector-grid'>
  <div class='seg-unlocated low'>
   <span class='lbl'>Sectores analizados</span>
   <b>" & FORMAT(_CantidadSectoresAnalizados_COA,"#,##0") & "</b>
   <span>con cartera de Coactiva en el filtro actual</span>
  </div>
  <div class='seg-unlocated critical'>
   <span class='lbl'>Cartera de la fase</span>
   <b>" & FORMAT(_CarteraCoactivaTotal,"$ #,##0.00") & "</b>
   <span>monto considerado en Coactiva</span>
  </div>
  <div class='seg-unlocated high'>
   <span class='lbl'>Contribuyentes</span>
   <b>" & FORMAT(_ContribuyentesCoactivaTotal,"#,##0") & "</b>
   <span>con presencia en la fase</span>
  </div>
  <div class='seg-unlocated medium'>
   <span class='lbl'>Promedio / contribuyente</span>
   <b>" & FORMAT(_PromedioCoactivaPorContribuyente,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_ObligacionesCoactivaTotal,"#,##0") & " obligaciones</span>
  </div>
 </div>
 <div class='seg-risk-filter-shell'>
  <input class='seg-risk-filter-input seg-risk-filter-critical' type='checkbox' id='risk-sector-coa-critical' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-high' type='checkbox' id='risk-sector-coa-high' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-medium' type='checkbox' id='risk-sector-coa-medium' checked='checked'/>
  <input class='seg-risk-filter-input seg-risk-filter-low' type='checkbox' id='risk-sector-coa-low' checked='checked'/>
  <div class='seg-risk-filter-bar'>
   <span class='seg-risk-filter-title'>Filtrar segmentación</span>
   <label class='seg-risk-label-critical' for='risk-sector-coa-critical'>CRÍTICO</label>
   <label class='seg-risk-label-high' for='risk-sector-coa-high'>ALTO</label>
   <label class='seg-risk-label-medium' for='risk-sector-coa-medium'>MEDIO</label>
   <label class='seg-risk-label-low' for='risk-sector-coa-low'>BAJO</label>
   <span class='seg-risk-filter-hint'>Selección múltiple · recalcula contribuyentes, cartera y promedio dentro de Coactiva</span>
  </div>
  <div class='seg-risk-filter-content'>
   <div class='seg-table-wrap'>
    <table class='seg-table'>
     <thead><tr>
      <th style='width:22%;text-align:left'>Sector / nomenclatura</th>
      <th style='width:8%;text-align:right'>Críticos</th>
      <th style='width:8%;text-align:right'>Altos</th>
      <th style='width:8%;text-align:right'>Medios</th>
      <th style='width:8%;text-align:right'>Bajos</th>
      <th style='width:10%;text-align:right'>Contribuyentes</th>
      <th style='width:18%;text-align:right'>Cartera territorial</th>
      <th style='width:18%;text-align:right'>Promedio / contribuyente</th>
     </tr></thead>
     <tbody>" & _HtmlSegmentacionSector_COA & _HtmlBrechas_COA & "</tbody>
    </table>
   </div>
  </div>
 </div>
 <div class='seg-location-note'>
  <b>Criterio:</b> la clasificación de riesgo permanece consolidada; la pestaña separa únicamente el saldo correspondiente a Coactiva. Al final, <b>REVISAR UBICACIÓN</b> desglosa la brecha territorial de Coactiva.
 </div>
</div>
 </div>
</div>
 </div>

</div>
<div class='notif-unified'>
 <div class='notif-head'>
  <div>
   <h3>Capacidad operativa de notificación</h3>
   <p>Separa la cartera que puede gestionarse hoy de la que está bloqueada por falta de ubicación, y muestra qué calidad de datos debe mejorarse sin frenar la notificación.</p>
  </div>
  <div class='notif-criterion'>01 Sin ubicación = no notificable</div>
 </div>

 <div class='notif-kpis'>
  <div class='notif-kpi yes'>
   <div class='lbl'>Cartera ubicable / notificable</div>
   <b>" & FORMAT(_CarteraNotificableHoy,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_PctCarteraNotificableHoy,"0.0%") & " de la cartera · " &
        FORMAT(_ObligNotificablesHoy,"#,##0") & " obligaciones · " &
        FORMAT(_ContribNotificablesHoy,"#,##0") & " contribuyentes (" &
        FORMAT(_PctContribNotificablesHoy,"0.0%") & ")</span>
  </div>

  <div class='notif-kpi no'>
   <div class='lbl'>Bloqueada · sin ubicación</div>
   <b>" & FORMAT(_CarteraNoNotificableHoy,"$ #,##0.00") & "</b>
   <span>" & FORMAT(_PctCarteraNoNotificableHoy,"0.0%") & " de la cartera · " &
        FORMAT(_ObligNoNotificablesHoy,"#,##0") & " obligaciones · " &
        FORMAT(_ContribNoNotificablesHoy,"#,##0") & " contribuyentes</span>
  </div>
 </div>

 <div class='notif-bar'>
  <div class='yes' style='width:" & _WNotificable & "%'></div>
  <div class='no' style='width:" & _WNoNotificable & "%'></div>
 </div>

 <div class='notif-quick'>
  <div class='notif-quick-main'>
   <div class='eyebrow'>Lectura ejecutiva</div>
   <div class='headline'><strong>" & FORMAT(_PctCarteraNotificableHoy,"0.0%") & "</strong> de la cartera SÍ puede notificarse</div>
   <div class='copy'>" & _MensajeNotificacionEjecutivo & "</div>
  </div>

  <div class='notif-quick-side'>
   <div class='notif-quick-box direct'>
    <span class='lbl'>Notificación directa</span>
    <b>" & FORMAT(_CarteraUbicacionCompleta,"$ #,##0.00") & "</b>
    <span>" & FORMAT(_PctDirectoDentroNotificable,"0.0%") & " de la cartera notificable</span>
   </div>

   <div class='notif-quick-box improve'>
    <span class='lbl'>Notificar mientras se depura</span>
    <b>" & FORMAT(_CarteraNotificableIncompleta,"$ #,##0.00") & "</b>
    <span>" & FORMAT(_PctMejoraDentroNotificable,"0.0%") & " de la cartera notificable</span>
   </div>
  </div>

  <div style='grid-column:1/-1' class='notif-quick-split'>
   <div class='direct' style='width:" & _WDirectoDentroNotificable & "%'></div>
   <div class='improve' style='width:" & _WMejoraDentroNotificable & "%'></div>
  </div>
 </div>

 <div class='notif-action-title'>¿Qué decisión tomar con la cartera?</div>
 <div class='notif-action-sub'>La capacidad de notificar y la calidad de georreferenciación se analizan por separado para no bloquear casos que sí tienen una dirección utilizable.</div>

 <div class='notif-action-grid'>
  <div class='notif-action-card direct'>
   <span class='tag'>1 · NOTIFICAR YA</span>
   <h4>Ubicación completa</h4>
   <b>" & FORMAT(_CarteraUbicacionCompleta,"$ #,##0.00") & "</b>
   <p>Información territorial completa. Puede pasar directamente a programación de notificación y gestión territorial.</p>
   <div class='meta'>" &
       FORMAT(_PctAccionNotificarYa,"0.0%") & " de la cartera · " &
       FORMAT(_ObligUbicacionCompleta,"#,##0") & " obligaciones · " &
       FORMAT(_ContUbicacionCompleta,"#,##0") & " contrib. vinculados</div>
  </div>

  <div class='notif-action-card improve'>
   <span class='tag'>2 · NOTIFICAR + DEPURAR</span>
   <h4>Ubicación disponible, calidad incompleta</h4>
   <b>" & FORMAT(_CarteraNotificableIncompleta,"$ #,##0.00") & "</b>
   <p>Existe información suficiente para ubicar/notificar. La depuración debe hacerse en paralelo y no debe frenar la gestión.</p>
   <div class='meta'>" &
       FORMAT(_PctAccionNotificarDepurar,"0.0%") & " de la cartera · " &
       FORMAT(_ObligNotificarDepurar,"#,##0") & " obligaciones</div>
  </div>

  <div class='notif-action-card blocked'>
   <span class='tag'>3 · INVESTIGAR</span>
   <h4>Sin ubicación disponible</h4>
   <b>" & FORMAT(_CarteraNoNotificableHoy,"$ #,##0.00") & "</b>
   <p>No existe ubicación suficiente en la base. Requiere enriquecimiento o cruce de fuentes antes de incorporarlo a una campaña de notificación.</p>
   <div class='meta'>" &
       FORMAT(_PctAccionInvestigar,"0.0%") & " de la cartera · " &
       FORMAT(_ObligNoNotificablesHoy,"#,##0") & " obligaciones · " &
       FORMAT(_ContribNoNotificablesHoy,"#,##0") & " contribuyentes</div>
  </div>
 </div>

 <div class='notif-quality'>
  <div class='notif-quality-head'>
   <h4>Qué falta corregir dentro de la cartera que SÍ puede notificarse</h4>
   <span>" & FORMAT(_CarteraNotificableIncompleta,"$ #,##0.00") & " requieren mejora de calidad</span>
  </div>

  <div class='notif-quality-grid'>
   <div class='notif-quality-card coords'>
    <div class='lbl'>Sin coordenadas</div>
    <b>" & FORMAT(_CarteraSinCoordenadas,"$ #,##0.00") & "</b>
    <span>Notificar con la dirección disponible y geocodificar en paralelo · " &
         FORMAT(_ObligSinCoordenadas,"#,##0") & " oblig. · " &
         FORMAT(_ContSinCoordenadas,"#,##0") & " contrib. vinculados</span>
   </div>

   <div class='notif-quality-card parish'>
    <div class='lbl'>Sin parroquia</div>
    <b>" & FORMAT(_CarteraSinParroquia,"$ #,##0.00") & "</b>
    <span>Notificar con la ubicación existente y completar/homologar parroquia · " &
         FORMAT(_ObligSinParroquia,"#,##0") & " oblig. · " &
         FORMAT(_ContSinParroquia,"#,##0") & " contrib. vinculados</span>
   </div>

   <div class='notif-quality-card sector'>
    <div class='lbl'>Sin sector</div>
    <b>" & FORMAT(_CarteraSinSector,"$ #,##0.00") & "</b>
    <span>Notificar con la ubicación existente y completar sector para análisis territorial · " &
         FORMAT(_ObligSinSector,"#,##0") & " oblig. · " &
         FORMAT(_ContSinSector,"#,##0") & " contrib. vinculados</span>
   </div>
  </div>
 </div>

 <div class='notif-action-bar'>
  <div class='direct' style='width:" & _WAccionNotificarYa & "%'></div>
  <div class='improve' style='width:" & _WAccionNotificarDepurar & "%'></div>
  <div class='blocked' style='width:" & _WAccionInvestigar & "%'></div>
 </div>

 <div class='notif-decision'>
  <div class='title'>" & _DecisionEjecutivaNotificacion & "</div>
  <div class='text'>" & _MensajeEjecutivoNotificacion & "</div>
  <div class='legend'>Verde: notificar directamente · Amarillo: notificar y depurar en paralelo · Rojo: investigar ubicación antes de notificar.</div>
 </div>
</div>

<div class='nogeo-rubros'>
 <div class='nogeo-rubros-head'>
  <div>
   <h3>Rubros bloqueados por falta de ubicación</h3>
   <p>Prioriza dónde realizar enriquecimiento de datos antes de programar nuevas notificaciones.</p>
  </div>
  <div class='nogeo-rubros-summary'>
   <b>" & FORMAT(_CarteraNoNotificableHoy,"$ #,##0.00") & "</b>
   " & FORMAT(_CantidadRubrosNoNotificables,"#,##0") & " rubros · " &
   FORMAT(_ObligNoNotificablesHoy,"#,##0") & " obligaciones · " &
   FORMAT(_ContribNoNotificablesHoy,"#,##0") & " contribuyentes
  </div>
 </div>

 <div class='nogeo-table-wrap'>
  <table class='nogeo-table'>
   <thead>
    <tr>
     <th style='width:45%;text-align:left'>Tipo de deuda</th>
     <th style='width:14%;text-align:right'>Obligaciones</th>
     <th style='width:14%;text-align:right'>Contribuyentes</th>
     <th style='width:17%;text-align:right'>Monto</th>
     <th style='width:10%;text-align:center'>% sin ubicación</th>
    </tr>
   </thead>
   <tbody>
    " & _HtmlRubrosNoNotificables & "
   </tbody>
  </table>
 </div>

 <div class='nogeo-note'>
  <b>Uso ejecutivo:</b> trabajar primero los rubros con mayor monto bloqueado. Este universo corresponde exclusivamente a 01. SIN UBICACION.
 </div>
</div>

<div class='footer'>
Todos los componentes se recalculan con los filtros activos de Power BI. 
Segmentación operativa: Crítico ≥ $10.000 o ≥ 11 obligaciones; Alto ≥ $5.000 o ≥ 6; Medio ≥ $1.000 o ≥ 4; Bajo = resto. Fase TÍTULOS: incluye GAT, NIT, TIN y TIS según el filtro activo de EstadoEspecifico.
</div>

</div>
"