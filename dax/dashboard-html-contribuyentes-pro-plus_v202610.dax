VAR _SegmentacionSectorFaseBase =
    FILTER (
        ADDCOLUMNS (
            CALCULATETABLE (
                SUMMARIZECOLUMNS (
                    'GEOREFERENCIACION'[SectorNomenclatura],
                    'GEOREFERENCIACION'[CodFaseDeuda]
                ),
                KEEPFILTERS ( _FiltroCartera )
            ),

            "__CriticosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__AltosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MediosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__BajosSector",
                CALCULATE (
                    DISTINCTCOUNT ( 'GEOREFERENCIACION'[IdContribuyente] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoCriticosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsCriticos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoAltosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsAltos, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoMediosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsMedios, 'GEOREFERENCIACION'[IdContribuyente] )
                ),

            "__MontoBajosSector",
                CALCULATE (
                    SUM ( 'GEOREFERENCIACION'[ValorTotal] ),
                    KEEPFILTERS ( _FiltroCartera ),
                    TREATAS ( _IdsBajos, 'GEOREFERENCIACION'[IdContribuyente] )
                )
        ),
        NOT ISBLANK ( 'GEOREFERENCIACION'[SectorNomenclatura] )
            && TRIM ( 'GEOREFERENCIACION'[SectorNomenclatura] & "" ) <> ""
            && 'GEOREFERENCIACION'[CodFaseDeuda] IN { "TIT", "COA" }
            && (
                [__CriticosSector]
                + [__AltosSector]
                + [__MediosSector]
                + [__BajosSector]
            ) > 0
    )

VAR _SegmentacionSectorFase =
    ADDCOLUMNS (
        _SegmentacionSectorFaseBase,
        "__PrioridadSector",
            [__CriticosSector] + [__AltosSector],
        "__PresenciasSector",
            [__CriticosSector]
            + [__AltosSector]
            + [__MediosSector]
            + [__BajosSector],
        "__CarteraSector",
            COALESCE ( [__MontoCriticosSector], 0 )
            + COALESCE ( [__MontoAltosSector], 0 )
            + COALESCE ( [__MontoMediosSector], 0 )
            + COALESCE ( [__MontoBajosSector], 0 )
    )

VAR _SegmentacionSector_TIT =
    FILTER (
        _SegmentacionSectorFase,
        'GEOREFERENCIACION'[CodFaseDeuda] = "TIT"
    )

VAR _SegmentacionSector_COA =
    FILTER (
        _SegmentacionSectorFase,
        'GEOREFERENCIACION'[CodFaseDeuda] = "COA"
    )

VAR _CantidadSectoresAnalizados_TIT = COUNTROWS ( _SegmentacionSector_TIT )
VAR _CantidadSectoresAnalizados_COA = COUNTROWS ( _SegmentacionSector_COA )

VAR _HtmlSegmentacionSector_TIT =
    CONCATENATEX (
