                    data-cl='" & FORMAT ( DIVIDE ( _MontoCrit + _MontoBaj, _Crit + _Baj, 0 ), "$ #,##0.00" ) & "'
                    data-hm='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoMed, _Alt + _Med, 0 ), "$ #,##0.00" ) & "'
                    data-hl='" & FORMAT ( DIVIDE ( _MontoAlt + _MontoBaj, _Alt + _Baj, 0 ), "$ #,##0.00" ) & "'
